---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { getCollection, getEntry, render } from "astro:content";
import { ConfigProvider } from "antd";
import { ArrowLeftOutlined } from "@ant-design/icons";

const antdConfig = {
  token: {
    colorPrimary: "#2563EB",
    colorLink: "#10B981",
    colorBgContainer: "#FFFFFF",
    colorBgElevated: "#FFFFFF",
    colorText: "#1E293B",
    colorTextSecondary: "#64748B",
    colorBorder: "#E2E8F0",
    borderRadius: 8,
    fontFamily: "'Noticia Text', serif",
  },
};

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

// Calculate read time
const wordCount = (post.body || '').split(' ').length;
const readTime = Math.ceil(wordCount / 200);

// Get related posts (same tags)
const allPosts = await getCollection("blog");
const relatedPosts = allPosts
  .filter(p => p.slug !== post.slug)
  .map(p => ({
    ...p,
    commonTags: p.data.tags?.filter(tag => post.data.tags?.includes(tag))?.length || 0
  }))
  .filter(p => p.commonTags > 0)
  .sort((a, b) => b.commonTags - a.commonTags)
  .slice(0, 3);
---

<ConfigProvider {...antdConfig}>
  <Layout title={`${post.data.title} | Zero Jump One`}>
    <Header />
    <article class="blog-main">
      <div class="container" style="max-width: 800px;">
        <a href="/blog" class="back-link">
          <ArrowLeftOutlined />
          <span>Volver</span>
        </a>
        
        <header class="post-header">
          <time class="post-date">
            {post.data.date.toLocaleDateString("es-ES", {
              year: "numeric",
              month: "long",
              day: "numeric",
              timeZone: "UTC",
            })}
            <span class="read-time"> · {readTime} min lectura</span>
          </time>
          <h1 class="post-title">{post.data.title}</h1>
          <div class="post-author">
            <span class="author-name">{post.data.author}</span>
            {post.data.academicDegree && (
              <span class="author-degree"> · {post.data.academicDegree}</span>
            )}
          </div>
          {post.data.tags && (
            <div class="post-tags">
              {post.data.tags.map((tag) => (
                <span class="tag">{tag}</span>
              ))}
            </div>
          )}
          {post.data.image && (
            <div class="post-hero-image">
              <img src={post.data.image} alt={post.data.title} />
            </div>
          )}
        </header>

        <div class="post-body">
          <Content />
        </div>

        {relatedPosts.length > 0 && (
          <section class="related-posts">
            <h2>Posts relacionados</h2>
            <div class="related-grid">
              {relatedPosts.map((related) => (
                <a href={`/blog/${related.slug}/`} class="related-card">
                  {related.data.image && (
                    <img src={related.data.image} alt={related.data.title} />
                  )}
                  <div class="related-content">
                    <h3>{related.data.title}</h3>
                    <span class="read-time">{Math.ceil((related.body || '').split(' ').length / 200)} min lectura</span>
                  </div>
                </a>
              ))}
            </div>
          </section>
        )}

        <footer class="post-footer">
          <a href="/blog" class="back-link">
            <ArrowLeftOutlined />
            <span>Volver</span>
          </a>
        </footer>
      </div>
    </article>
    <Footer />
  </Layout>
</ConfigProvider>

<style>
  .blog-main {
    padding: 120px 20px 60px;
    min-height: 100vh;
    background: #f8fafc;
  }

  .container {
    animation: fadeInUp 0.6s ease forwards;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #2563eb;
    font-weight: 600;
    margin-bottom: 32px;
    transition: all 0.3s ease;
  }

  .back-link:hover {
    color: #1d4ed8;
  }

  .post-header {
    margin-bottom: 48px;
  }

  .post-date {
    display: block;
    font-size: 0.875rem;
    color: #94a3b8;
    margin-bottom: 12px;
  }

  .read-time {
    font-style: italic;
    color: #94a3b8;
  }

  .post-title {
    font-size: clamp(2rem, 5vw, 3rem);
    color: #1e293b;
    line-height: 1.2;
    margin-bottom: 8px;
  }

  .post-author {
    display: block;
    margin-bottom: 16px;
  }

  .author-name {
    font-size: 0.95rem;
    color: #10b981;
    font-weight: 600;
  }

  .author-degree {
    font-size: 0.875rem;
    color: #64748b;
    font-weight: 400;
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 32px;
  }

  .tag {
    display: inline-block;
    padding: 4px 12px;
    background: #f0fdf4;
    color: var(--arbol-claro);
    border-radius: 20px;
    font-size: 0.8rem;
    font-weight: 500;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .tag:hover {
    transform: scale(1.05);
    background: var(--arbol-claro);
    color: white;
  }

  .related-posts {
    margin-top: 80px;
    padding-top: 40px;
    border-top: 1px solid #e2e8f0;
  }

  .related-posts h2 {
    font-size: 1.5rem;
    color: #1e293b;
    margin-bottom: 24px;
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 20px;
  }

  .related-card {
    display: block;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    overflow: hidden;
    transition: all 0.3s ease;
    background: white;
  }

  .related-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 30px rgba(58, 179, 74, 0.12);
    border-color: #c6eac7;
  }

  .related-card img {
    width: 100%;
    height: 150px;
    object-fit: cover;
  }

  .related-content {
    padding: 16px;
  }

  .related-content h3 {
    font-size: 1rem;
    color: #1e293b;
    margin-bottom: 8px;
    line-height: 1.3;
  }

  .post-hero-image {
    width: 100%;
    border-radius: 12px;
    overflow: hidden;
    margin-top: 32px;
    background: #f1f5f9;
  }

  .post-hero-image img {
    width: 100%;
    height: auto;
    display: block;
  }

  .post-body {
    color: #1e293b;
    line-height: 1.8;
    font-size: 1.125rem;
    text-align: justify;
  }

  .post-body h2 {
    font-size: 1.75rem;
    margin-top: 48px;
    margin-bottom: 16px;
    color: #1e293b;
  }

  .post-body h3 {
    font-size: 1.375rem;
    margin-top: 32px;
    margin-bottom: 12px;
    color: #1e293b;
  }

  .post-body p {
    margin-bottom: 20px;
  }

  .post-body ul, .post-body ol {
    margin-bottom: 20px;
    padding-left: 24px;
  }

  .post-body li {
    margin-bottom: 8px;
  }

  .post-body code {
    background: #f1f5f9;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 0.9em;
  }

  .post-body pre {
    background: #0f172a;
    color: #e2e8f0;
    padding: 20px;
    border-radius: 8px;
    overflow-x: auto;
    margin-bottom: 20px;
  }

  .post-body pre code {
    background: none;
    padding: 0;
    color: inherit;
  }

  .post-body blockquote {
    border-left: 4px solid var(--primary);
    padding-left: 20px;
    margin: 24px 0;
    font-style: italic;
    color: #64748b;
  }

  .post-footer {
    margin-top: 64px;
    padding-top: 32px;
    border-top: 1px solid #e2e8f0;
  }

  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(30px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (max-width: 768px) {
    .blog-main {
      padding: 100px 16px 40px;
    }

    .post-title {
      font-size: 2rem;
    }

    .post-body {
      font-size: 1rem;
    }
  }
</style>
