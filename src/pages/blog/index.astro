---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { getCollection } from "astro:content";
import { ConfigProvider } from "antd";
import { ArrowLeftOutlined } from "@ant-design/icons";

const antdConfig = {
  token: {
    colorPrimary: "#2563EB",
    colorLink: "#10B981",
    colorBgContainer: "#FFFFFF",
    colorBgElevated: "#FFFFFF",
    colorText: "#1E293B",
    colorTextSecondary: "#64748B",
    colorBorder: "#E2E8F0",
    borderRadius: 8,
    fontFamily: "'Noticia Text', serif",
  },
};

const posts = await getCollection("blog");
const sortedPosts = posts.sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
---

<ConfigProvider {...antdConfig}>
  <Layout title="Blog | Zero Jump One">
    <Header />
    <main class="blog-main">
      <div class="container">
        <a href="/#footer" class="back-link">
          <ArrowLeftOutlined />
          <span>Volver</span>
        </a>

        <div class="section-header">
          <span class="section-label">Blog</span>
          <h1 class="section-title">Artículos y recursos</h1>
          <p class="section-subtitle">
            Descubre las últimas tendencias en tecnología y desarrollo de
            software
          </p>
        </div>

        <div class="masonry-grid">
          {
            sortedPosts.map((post, index) => (
              <a
                href={`/blog/${post.slug}/`}
                class="masonry-item"
                style={`animation-delay: ${0.1 + index * 0.05}s`}
              >
                {post.data.image && (
                  <div class="post-image">
                    <img src={post.data.image} alt={post.data.title} />
                  </div>
                )}
                <div class="post-content">
                  <time class="post-date">
                    {post.data.date.toLocaleDateString("es-ES", {
                      year: "numeric",
                      month: "long",
                      day: "numeric",
                      timeZone: "UTC",
                    })}
                  </time>
                  <h2 class="post-title">{post.data.title}</h2>
                  <span class="post-author-card">{post.data.author}</span>
                  {post.data.excerpt && (
                    <p class="post-excerpt">{post.data.excerpt}</p>
                  )}
                  {post.data.tags && (
                    <div class="post-tags">
                      {post.data.tags.map((tag) => (
                        <span class="tag">{tag}</span>
                      ))}
                    </div>
                  )}
                  <span class="read-time">
                    {Math.ceil((post.body || '').split(' ').length / 200)} min lectura
                  </span>
                </div>
              </a>
            ))
          }
        </div>
      </div>
    </main>
    <Footer />
  </Layout>
</ConfigProvider>

<style>
  .blog-main {
    padding: 120px 20px 60px;
    min-height: 100vh;
    background: #f8fafc;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    animation: fadeInUp 0.6s ease forwards;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #2563eb;
    font-weight: 600;
    margin-bottom: 32px;
    transition: all 0.3s ease;
  }

  .back-link:hover {
    color: #1d4ed8;
  }

  .masonry-grid {
    column-count: 3;
    column-gap: 24px;
    max-width: 1200px;
    margin: 0 auto;
  }

  .masonry-item {
    break-inside: avoid;
    margin-bottom: 24px;
    display: inline-block;
    width: 100%;
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    overflow: hidden;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    cursor: pointer;
    animation: fadeInUp 0.6s ease forwards;
    opacity: 0;
  }

  .masonry-item:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 30px rgba(58, 179, 74, 0.12);
    border-color: #c6eac7;
  }

  .masonry-item:nth-child(1) {
    animation-delay: 0.1s;
  }
  .masonry-item:nth-child(2) {
    animation-delay: 0.15s;
  }
  .masonry-item:nth-child(3) {
    animation-delay: 0.2s;
  }
  .masonry-item:nth-child(4) {
    animation-delay: 0.25s;
  }
  .masonry-item:nth-child(5) {
    animation-delay: 0.3s;
  }
  .masonry-item:nth-child(6) {
    animation-delay: 0.35s;
  }
  .masonry-item:nth-child(7) {
    animation-delay: 0.4s;
  }
  .masonry-item:nth-child(8) {
    animation-delay: 0.45s;
  }

  .masonry-item:first-child .post-image {
    height: 280px;
  }

  .post-image {
    width: 100%;
    aspect-ratio: 16/9;
    overflow: hidden;
    background: #f1f5f9;
  }

  .post-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .masonry-item:hover .post-image img {
    transform: scale(1.05);
  }

  .post-content {
    padding: 20px;
  }

  .post-date {
    display: block;
    font-size: 0.875rem;
    color: #64748b;
    margin-bottom: 8px;
    font-weight: 500;
  }

  .post-title {
    font-size: 1.25rem;
    color: #1e293b;
    margin-bottom: 8px;
    line-height: 1.3;
  }

  .post-author-card {
    display: block;
    font-size: 0.85rem;
    color: #10b981;
    font-weight: 600;
    margin-bottom: 8px;
  }

  .post-excerpt {
    font-size: 0.95rem;
    color: #64748b;
    line-height: 1.6;
    margin-bottom: 16px;
  }

  .read-time {
    display: block;
    font-size: 0.8rem;
    color: #94a3b8;
    margin-top: 8px;
    font-style: italic;
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .tag {
    display: inline-block;
    padding: 4px 12px;
    background: #f0fdf4;
    color: var(--arbol-claro);
    border-radius: 20px;
    font-size: 0.8rem;
    font-weight: 500;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .tag:hover {
    transform: scale(1.05);
    background: var(--arbol-claro);
    color: white;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 1024px) {
    .masonry-grid {
      column-count: 2;
    }
  }

  @media (max-width: 640px) {
    .masonry-grid {
      column-count: 1;
    }

    .blog-main {
      padding: 100px 16px 40px;
    }
  }
</style>
