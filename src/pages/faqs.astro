---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { ConfigProvider } from "antd";
import { ArrowLeftOutlined, QuestionCircleOutlined } from "@ant-design/icons";
import { faqsData } from "../data/faqs";

const antdConfig = {
  token: {
    colorPrimary: "#2563EB",
    colorLink: "#10B981",
    colorBgContainer: "#FFFFFF",
    colorBgElevated: "#FFFFFF",
    colorText: "#1E293B",
    colorTextSecondary: "#64748B",
    colorBorder: "#E2E8F0",
    borderRadius: 8,
    fontFamily: "'Inter', -apple-system, BlinkMacSystemFont, sans-serif",
  },
};
---

<ConfigProvider {...antdConfig}>
  <Layout title="Preguntas Frecuentes | Zero Jump One">
    <Header />

    <main class="faq-main">
      <div class="container">
        <a href="/#footer" class="back-link">
          <ArrowLeftOutlined />
          <span>Volver</span>
        </a>

        <h1 class="page-title">
          <QuestionCircleOutlined />
          Preguntas Frecuentes
        </h1>
        <p class="page-subtitle">
          Encuentra respuestas a las dudas más comunes sobre nuestros servicios
        </p>

        <div class="faq-grid">
          {faqsData.map((faq, index) => (
            <details class="faq-card" open={index < 3}>
              <summary class="faq-question">
                <span class="faq-number">{String(index + 1).padStart(2, '0')}</span>
                <span class="faq-text">{faq.question}</span>
              </summary>
              <div class="faq-answer">
                <p>{faq.answer}</p>
                {faq.category && <span class="faq-category">{faq.category}</span>}
              </div>
            </details>
          ))}
        </div>
      </div>
    </main>

    <Footer />
  </Layout>
</ConfigProvider>

<style>
  .faq-main {
    padding: 120px 20px 60px;
    min-height: 100vh;
    background: #f8fafc;
  }

  .container {
    max-width: 800px;
    margin: 0 auto;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #2563eb;
    font-weight: 600;
    margin-bottom: 32px;
    transition: all 0.3s ease;
  }

  .back-link:hover {
    color: #1d4ed8;
  }

  .page-title {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 2.5rem;
    font-weight: 700;
    color: #1e293b;
    margin-bottom: 8px;
  }

  .page-title :global(.anticon) {
    color: var(--arbol-claro);
  }

  .page-subtitle {
    font-size: 1.125rem;
    color: #64748b;
    margin-bottom: 40px;
  }

  .faq-grid {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .faq-card {
    background: white;
    border-radius: 16px;
    border: 1px solid #e2e8f0;
    overflow: hidden;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .faq-card:hover {
    box-shadow: 0 8px 30px rgba(58, 179, 74, 0.12);
    border-color: #c6eac7;
    transform: translateY(-2px);
  }

  .faq-card[open] {
    border-color: var(--arbol-claro);
    box-shadow: 0 8px 30px rgba(58, 179, 74, 0.15);
  }

  .faq-question {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 20px 24px;
    cursor: pointer;
    list-style: none;
    font-weight: 600;
    color: #1e293b;
    transition: all 0.3s ease;
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-question:hover {
    background: linear-gradient(90deg, #f0fdf4 0%, #f8fafc 100%);
  }

  .faq-question::after {
    content: "+";
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    background: #f1f5f9;
    border-radius: 8px;
    font-size: 1.25rem;
    font-weight: 400;
    color: #64748b;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    flex-shrink: 0;
  }

  details[open] .faq-question::after {
    transform: rotate(45deg);
    background: var(--arbol-claro);
    color: white;
  }

  details[open] .faq-question {
    background: linear-gradient(90deg, #f0fdf4 0%, #f8fafc 100%);
  }

  .faq-number {
    background: linear-gradient(135deg, var(--arbol-claro) 0%, var(--arbol-obscuro) 100%);
    color: white;
    width: 32px;
    height: 32px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.875rem;
    font-weight: 700;
    flex-shrink: 0;
    box-shadow: 0 2px 8px rgba(58, 179, 74, 0.3);
  }

  .faq-text {
    flex: 1;
    font-size: 1rem;
    transition: color 0.3s ease;
  }

  details[open] .faq-text {
    color: var(--arbol-obscuro);
  }

  .faq-answer {
    padding: 0 24px 20px 72px;
    color: #475569;
    line-height: 1.7;
  }

  .faq-answer p {
    margin: 0 0 12px;
  }

  .faq-category {
    display: inline-block;
    background: #f0fdf4;
    color: var(--arbol-claro);
    font-size: 0.75rem;
    font-weight: 600;
    padding: 4px 12px;
    border-radius: 20px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  @media (max-width: 576px) {
    .faq-main {
      padding: 100px 16px 40px;
    }

    .page-title {
      font-size: 1.75rem;
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
    }

    .faq-question {
      padding: 16px;
      gap: 12px;
    }

    .faq-number {
      width: 28px;
      height: 28px;
      font-size: 0.75rem;
    }

    .faq-answer {
      padding: 0 16px 16px 16px;
    }
  }
</style>