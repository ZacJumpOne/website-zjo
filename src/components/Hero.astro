---
import { Button } from "antd";
import {
  ArrowRightOutlined,
  RocketOutlined,
  ThunderboltOutlined,
  SafetyCertificateOutlined,
} from "@ant-design/icons";
import FloatingCards from "./FloatingCards.astro";

export type FloatingCardPosition = "top-left" | "top-right" | "bottom-left" | "bottom-right" | "top-center" | "bottom-center";

export interface FloatingCardSlide {
  mainImage: string;
  mainImageAlt?: string;
  cardTitle?: string;
  mainImagePosition: string;
  floatingCards: Array<{
    icon: string;
    text: string;
    position: FloatingCardPosition;
  }>;
}

const floatingCardsBase: Array<{ icon: string; text: string; position: FloatingCardPosition }> = [
  { icon: "CloudOutlined", text: "Nube", position: "top-left" },
  { icon: "LockOutlined", text: "Seguro", position: "top-right" },
  { icon: "GlobalOutlined", text: "Web Services", position: "bottom-left" },
  { icon: "LaptopOutlined", text: "Multi sesiones", position: "bottom-right" },
];

const slides: FloatingCardSlide[] = [
    {
    mainImage: "/images/web_erp3.webp",
    mainImageAlt: "ERP Jump One",
    cardTitle: "ERP Jump One",
    mainImagePosition: "bottom-center",
    floatingCards: [
      { icon: "ControlOutlined", text: "Control", position: "top-left" },
      { icon: "ToolOutlined", text: "Mejora", position: "top-right" },
      { icon: "RocketOutlined", text: "Vanguardia", position: "bottom-left" },
      { icon: "CheckCircleOutlined", text: "Solucion", position: "bottom-right" },
    ],
  },
  {
    mainImage: "/images/boutique.webp",
    mainImageAlt: "Control tallas, colores o ambas",
    cardTitle: "ERP Jump One | Boutique",
    mainImagePosition: "bottom-center",
    floatingCards: [
      { icon: "BarcodeOutlined", text: "Control", position: "top-left" },
      { icon: "SkinOutlined", text: "Tallas", position: "top-right" },
      { icon: "BgColorsOutlined", text: "Colores", position: "bottom-left" },
      { icon: "CheckCircleOutlined", text: "Tallas y Colores", position: "bottom-right" },
    ],
  },
  {
    mainImage: "/images/retail.webp",
    mainImageAlt: "Control almacenes y puntos de venta",
    cardTitle: "ERP Jump One | Retail",
    mainImagePosition: "bottom-center",
    floatingCards: [
      { icon: "ShopOutlined", text: "Control", position: "top-left" },
      { icon: "ProductOutlined", text: "Productos", position: "top-right" },
      { icon: "EnvironmentOutlined", text: "Ubicaciones", position: "bottom-left" },
      { icon: "RedoOutlined", text: "Rotacion", position: "bottom-right" },
    ],
  },
  {
    mainImage: "/images/zapato.webp",
    mainImageAlt: "Control de produccion",
    cardTitle: "ERP Jump One | Producción",
    mainImagePosition: "bottom-center",
    floatingCards: [ 
      { icon: "CalendarOutlined", text: "Control", position: "top-left" },
      { icon: "ExperimentOutlined", text: "BOM", position: "top-right" },
      { icon: "RestOutlined", text: "Materiales", position: "bottom-left" },
      { icon: "DollarOutlined", text: "$ Costos", position: "bottom-right" },
    ],
  },
  {
    mainImage: "/images/construccion.webp",
    mainImageAlt: "Control de proyectos de construcción",
    cardTitle: "ERP Jump One | Construcción",
    mainImagePosition: "top-center",
    floatingCards: [
      { icon: "ScheduleOutlined", text: "Control", position: "top-left" },
      { icon: "RestOutlined", text: "Materiales", position: "top-right" },
      { icon: "DollarOutlined", text: "$ Costos", position: "bottom-left" },
      { icon: "CheckCircleOutlined", text: "$ Obras", position: "bottom-right" },
    ],
  },

];
---

<section class="hero" id="inicio">
  <div class="hero-bg">
    <div class="floating-shapes">
      <div class="shape shape-1"></div>
      <div class="shape shape-2"></div>
      <div class="shape shape-3"></div>
      <div class="shape shape-4"></div>
      <div class="shape shape-5"></div>
    </div>

    <div class="grid-pattern"></div>

    <div class="hero-glow"></div>
  </div>

  <div class="container">
    <div class="hero-grid">
      <div class="hero-content">
        <div class="hero-badge" data-animate>
          <div class="badge-icon">
            <SafetyCertificateOutlined />
          </div>
          <span class="badge-text">El software que lo hace posible</span>
          <div class="badge-shimmer"></div>
        </div>

        <h1 class="hero-title" data-animate>
          <span class="title-line">Software Empresarial</span>
          <span class="title-line title-accent">
            <span class="accent-amp">&</span> Comercial
          </span>
        </h1>

        <p class="hero-description" data-animate>
          Desarrollamos aplicaciones robustas, sencillas y rapidas, para que
          nuestros clientes tengan la mejor experiencia en el control de sus
          negocios.
        </p>

        <div class="hero-features" data-animate>
          <div class="feature">
            <div class="feature-icon"><RocketOutlined /></div>
            <span>Desarrollo Rapido</span>
          </div>
          <div class="feature">
            <div class="feature-icon"><ThunderboltOutlined /></div>
            <span>Alto Rendimiento</span>
          </div>
          <div class="feature">
            <div class="feature-icon"><SafetyCertificateOutlined /></div>
            <span>Seguro y Confiable</span>
          </div>
        </div>

        <div class="hero-actions" data-animate>
          <a href="#portafolio" class="btn-primary">
            <span>Ver Portafolio</span>
            <div class="btn-icon"><ArrowRightOutlined /></div>
            <div class="btn-shine"></div>
          </a>
          <a href="#servicios" class="btn-secondary">
            <span>Conocer Mas</span>
          </a>
        </div>
      </div>

      <div class="hero-visual" data-animate>
        <div class="carousel-container">
          {slides.map((slide, index) => (
            <div class={`carousel-slide ${index === 0 ? 'active' : ''}`}>
              <FloatingCards
                mainImage={slide.mainImage}
                mainImageAlt={slide.mainImageAlt}
                mainImagePosition={slide.mainImagePosition}
                cardTitle={slide.cardTitle}
                floatingCards={slide.floatingCards}
              />
            </div>
          ))}

          <div class="carousel-indicators">
            {slides.map((_, index) => (
              <button
                class={`carousel-indicator ${index === 0 ? 'active' : ''}`}
                data-index={index}
                aria-label={`Slide ${index + 1}`}
              />
            ))}
          </div>
        </div>
      </div>
    </div>

    <div class="hero-stats" data-animate>
      <div class="stat" data-count="100">
        <span class="stat-suffix">+</span>
        <span class="stat-number">0</span>
        <span class="stat-label">Procesos Entregados</span>
      </div>
      <div class="stat-divider"></div>
      <div class="stat" data-count="100000">
        <span class="stat-suffix">+</span>
        <span class="stat-number">0</span>
        <span class="stat-label">Horas de control</span>
      </div>
      <div class="stat-divider"></div>
      <div class="stat" data-count="25">
        <span class="stat-suffix">+</span>
        <span class="stat-number">0</span>
        <span class="stat-label">Años de Experiencia</span>
      </div>
    </div>
  </div>

  <div class="scroll-indicator" data-animate>
    <div class="scroll-mouse">
      <div class="scroll-wheel"></div>
    </div>
    <span>Scroll</span>
  </div>
</section>

<style>
  .hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    position: relative;
    padding-top: 80px;
    padding-bottom: 60px;
     background: var(--gradient-bg, linear-gradient(180deg, #fafbfc 0%, #ffffff 50%, #f0f4f8 100%));
    overflow: hidden;
  }

  /* Background Effects */
  .hero-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .grid-pattern {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(5, 150, 105, 0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(5, 150, 105, 0.03) 1px, transparent 1px);
    background-size: 60px 60px;
    mask-image: radial-gradient(ellipse at center, black 20%, transparent 70%);
  }

  .hero-glow {
    position: absolute;
    top: -30%;
    right: -10%;
    width: 70%;
    height: 80%;
    background:
      radial-gradient(
        ellipse at center,
        var(--arbol-08, rgba(5, 150, 105, 0.08)) 0%,
        transparent 50%
      ),
      radial-gradient(
        ellipse at 70% 30%,
        var(--arbol-03, rgba(16, 185, 129, 0.05)) 0%,
        transparent 40%
      );
    filter: blur(60px);
  }

  /* Floating Shapes */
  .floating-shapes {
    position: absolute;
    inset: 0;
  }

  .shape {
    position: absolute;
    border-radius: 50%;
    opacity: 0;
    animation: floatIn 1s ease forwards;
  }

  .shape-1 {
    width: 300px;
    height: 300px;
    top: 10%;
    left: -5%;
    background: linear-gradient(
      135deg,
      var(--arbol-08, rgba(5, 150, 105, 0.08)) 0%,
      transparent 70%
    );
    animation-delay: 0.3s;
    animation: float1 20s ease-in-out infinite;
  }

  .shape-2 {
    width: 200px;
    height: 200px;
    top: 20%;
    right: 5%;
    background: linear-gradient(
      135deg,
      var(--arbol-06, rgba(5, 150, 105, 0.06)) 0%,
      transparent 70%
    );
    animation-delay: 0.5s;
    animation: float2 25s ease-in-out infinite;
  }

  .shape-3 {
    width: 150px;
    height: 150px;
    bottom: 30%;
    left: 10%;
    background: linear-gradient(
      135deg,
      var(--arbol-05, rgba(5, 150, 105, 0.05)) 0%,
      transparent 70%
    );
    animation-delay: 0.7s;
    animation: float3 18s ease-in-out infinite;
  }

  .shape-4 {
    width: 100px;
    height: 100px;
    top: 40%;
    right: 15%;
    background: linear-gradient(
      135deg,
      rgba(245, 158, 11, 0.06) 0%,
      transparent 70%
    );
    animation-delay: 0.9s;
    animation: float4 22s ease-in-out infinite;
  }

  .shape-5 {
    width: 180px;
    height: 180px;
    bottom: 15%;
    right: 25%;
    background: linear-gradient(
      135deg,
      var(--arbol-04, rgba(5, 150, 105, 0.04)) 0%,
      transparent 70%
    );
    animation-delay: 1.1s;
    animation: float5 28s ease-in-out infinite;
  }

  @keyframes float1 {
    0%,
    100% {
      transform: translate(0, 0) rotate(0deg);
    }
    25% {
      transform: translate(30px, -40px) rotate(5deg);
    }
    50% {
      transform: translate(-20px, -80px) rotate(-3deg);
    }
    75% {
      transform: translate(40px, -40px) rotate(3deg);
    }
  }

  @keyframes float2 {
    0%,
    100% {
      transform: translate(0, 0) rotate(0deg);
    }
    33% {
      transform: translate(-40px, 30px) rotate(-5deg);
    }
    66% {
      transform: translate(20px, 50px) rotate(5deg);
    }
  }

  @keyframes float3 {
    0%,
    100% {
      transform: translate(0, 0) scale(1);
    }
    50% {
      transform: translate(50px, -30px) scale(1.1);
    }
  }

  @keyframes float4 {
    0%,
    100% {
      transform: translate(0, 0);
    }
    25% {
      transform: translate(-30px, 20px);
    }
    50% {
      transform: translate(20px, 40px);
    }
    75% {
      transform: translate(-20px, 20px);
    }
  }

  @keyframes float5 {
    0%,
    100% {
      transform: translate(0, 0) rotate(0deg);
    }
    50% {
      transform: translate(-30px, -40px) rotate(180deg);
    }
  }

  /* Hero Grid */
  .container {
    position: relative;
    z-index: 10;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
    margin-bottom: 60px;
  }

  /* Content */
  .hero-content {
    text-align: left;
  }

  /* Badge */
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: linear-gradient(
      135deg,
      var(--arbol-10, rgba(5, 150, 105, 0.1)) 0%,
      var(--arbol-05, rgba(5, 150, 105, 0.05)) 100%
    );
    border: 1px solid rgba(5, 150, 105, 0.2);
    padding: 10px 20px;
    border-radius: 50px;
    margin-bottom: 24px;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--arbol-claro, #059669);
    position: relative;
    overflow: hidden;
    opacity: 0;
    transform: translateY(20px);
    animation: slideUp 0.6s ease forwards;
    animation-delay: 0.2s;
  }

  .badge-icon {
    display: flex;
    font-size: 1rem;
    color: var(--arbol-claro, #059669);
    animation: iconPulse 2s ease-in-out infinite;
  }

  @keyframes iconPulse {
    0%,
    100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.1);
    }
  }

  .badge-text {
    position: relative;
     background: var(--gradient-primary-dark, linear-gradient(135deg, var(--arbol-claro) 0%, var(--arbol-obscuro) 100%));
    background-size: 200% 100%;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    animation: gradientFlow 3s linear infinite;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  @keyframes gradientFlow {
    0% {
      background-position: 0% 50%;
    }
    100% {
      background-position: 200% 50%;
    }
  }

  .badge-shimmer {
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(255, 255, 255, 0.4),
      transparent
    );
    animation: shimmer 3s ease-in-out infinite;
  }

  @keyframes shimmer {
    0% {
      left: -100%;
    }
    50%,
    100% {
      left: 100%;
    }
  }

  /* Title */
  .hero-title {
    font-size: clamp(2rem, 4vw, 3.5rem);
    font-weight: 800;
    color: #0f172a;
    margin-bottom: 20px;
    line-height: 1.1;
    opacity: 0;
    transform: translateY(30px);
    animation: slideUp 0.7s ease forwards;
    animation-delay: 0.4s;
  }

  .title-line {
    display: block;
  }

   .title-accent {
    background: var(--gradient-primary-dark, linear-gradient(135deg, var(--arbol-claro) 0%, var(--arbol-obscuro) 100%));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .accent-amp {
    opacity: 0.5;
    -webkit-text-fill-color: var(--text-gray, #64748b);
  }

  /* Description */
  .hero-description {
    font-size: 1.1rem;
    color: var(--text-gray, #64748b);
    margin-bottom: 24px;
    line-height: 1.7;
    opacity: 0;
    transform: translateY(30px);
    animation: slideUp 0.6s ease forwards;
    animation-delay: 0.6s;
  }

  /* Features */
  .hero-features {
    display: flex;
    gap: 24px;
    margin-bottom: 32px;
    flex-wrap: wrap;
    opacity: 0;
    transform: translateY(20px);
    animation: slideUp 0.6s ease forwards;
    animation-delay: 0.7s;
  }

  .feature {
    display: flex;
    align-items: center;
    gap: 8px;
    color: #475569;
    font-size: 0.9rem;
    font-weight: 500;
  }

  .feature-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    background: linear-gradient(
      135deg,
      var(--arbol-10, rgba(5, 150, 105, 0.1)) 0%,
      var(--arbol-05, rgba(5, 150, 105, 0.05)) 100%
    );
    border-radius: 8px;
    color: var(--arbol-claro, #059669);
    font-size: 0.85rem;
  }

  /* Actions */
  .hero-actions {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    opacity: 0;
    transform: translateY(20px);
    animation: slideUp 0.6s ease forwards;
    animation-delay: 0.8s;
  }

   .btn-primary {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 14px 28px;
    background: var(--gradient-primary-dark, linear-gradient(135deg, var(--arbol-claro) 0%, var(--arbol-obscuro) 100%));
    color: white;
    font-weight: 600;
    font-size: 1rem;
    border-radius: 12px;
    overflow: hidden;
    transition: all 0.3s ease;
    box-shadow: 0 4px 14px rgba(5, 150, 105, 0.3);
  }

  .btn-primary:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 25px rgba(5, 150, 105, 0.4);
  }

  .btn-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    background: rgba(255, 255, 255, 0.2);
    border-radius: 6px;
    transition: transform 0.3s ease;
  }

  .btn-primary:hover .btn-icon {
    transform: translateX(4px);
  }

  .btn-shine {
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(255, 255, 255, 0.3),
      transparent
    );
    transition: left 0.5s ease;
  }

  .btn-primary:hover .btn-shine {
    left: 100%;
  }

  .btn-secondary {
    display: inline-flex;
    align-items: center;
    padding: 14px 28px;
    background: white;
    color: #0f172a;
    font-weight: 600;
    font-size: 1rem;
    border-radius: 12px;
    border: 1px solid #e2e8f0;
    transition: all 0.3s ease;
  }

  .btn-secondary:hover {
    border-color: var(--arbol-claro, #059669);
    color: var(--arbol-claro, #059669);
    transform: translateY(-2px);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.05);
  }

  /* Visual */
  .hero-visual {
    position: relative;
    height: 400px;
    opacity: 0;
    transform: translateY(30px);
    animation: slideUp 0.8s ease forwards;
    animation-delay: 0.5s;
  }

  /* Carousel */
  .carousel-container {
    position: relative;
    height: 100%;
    overflow: hidden;
  }

  .carousel-slide {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 400px;
    opacity: 0;
    transition: opacity 0.8s cubic-bezier(0.4, 0, 0.2, 1);
    pointer-events: none;
    z-index: 1;
  }

  .carousel-slide.active {
    opacity: 1;
    pointer-events: auto;
    z-index: 2;
  }

  .carousel-slide :global(.cards-visual) {
    height: 100%;
  }

  /* Indicadores: Dots con Morph Suave */
  .carousel-indicators {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 8px;
    margin-top: 16px;
    position: relative;
    z-index: 10;
  }

  .carousel-indicator {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #cbd5e1;
    border: none;
    cursor: pointer;
    padding: 0;
    transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .carousel-indicator:hover {
    background: #94a3b8;
    transform: scale(1.2);
  }

  .carousel-indicator.active {
    background: var(--arbol-claro, #059669);
    width: 28px;
    border-radius: 4px;
    box-shadow: 0 2px 8px rgba(5, 150, 105, 0.3);
  }

  .visual-card {
    position: absolute;
    background: white;
    border-radius: 16px;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
    border: 1px solid #e2e8f0;
  }

  .main-card {
    width: 85%;
    height: 280px;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 2;
  }

  .card-header {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px 20px;
    border-bottom: 1px solid #f1f5f9;
  }

  .card-dots {
    display: flex;
    gap: 6px;
  }

  .card-dots span {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #e2e8f0;
  }

  .card-dots span:first-child {
    background: #ef4444;
  }
  .card-dots span:nth-child(2) {
    background: #f59e0b;
  }
  .card-dots span:nth-child(3) {
    background: #22c55e;
  }

  .card-title {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-gray, #64748b);
  }

  .card-content {
    padding: 24px 20px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .stat-bar {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .stat-bar span:first-child {
    width: 80px;
    font-size: 0.8rem;
    color: var(--text-gray, #64748b);
  }

  .bar {
    flex: 1;
    height: 8px;
    background: #f1f5f9;
    border-radius: 4px;
    overflow: hidden;
  }

   .bar-fill {
    height: 100%;
    background: var(--gradient-bar, linear-gradient(90deg, var(--arbol-claro), var(--arbol-obscuro, #047857)));
    border-radius: 4px;
    animation: growBar 1.5s ease forwards;
    transform-origin: left;
  }

  @keyframes growBar {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }

  .bar-value {
    width: 40px;
    text-align: right;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--arbol-claro, #059669);
  }

  .card-footer {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 20px;
    border-top: 1px solid #f1f5f9;
    font-size: 0.8rem;
    color: var(--text-gray, #64748b);
  }

  .status {
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }

  .status.online {
    background: #22c55e;
    box-shadow: 0 0 8px rgba(34, 197, 94, 0.5);
  }

  /* Floating Cards */
  .floating-cards {
    position: absolute;
    inset: 0;
  }

  .floating-card {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 14px 18px;
    background: white;
    border-radius: 12px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
    border: 1px solid #e2e8f0;
    z-index: 3;
    transition: all 0.3s ease;
  }

  .floating-card:hover {
    transform: translateY(-4px) scale(1.05);
    box-shadow: 0 15px 40px rgba(0, 0, 0, 0.12);
  }

  .floating-card :global(.anticon) {
    font-size: 1.25rem;
    color: var(--arbol-claro, #059669);
  }

  .floating-card span {
    font-size: 0.8rem;
    font-weight: 600;
    color: #475569;
    white-space: nowrap;
  }

  .floating-cards .card-1 {
    top: 5%;
    left: 0;
    animation: floatCard 6s ease-in-out infinite;
  }

  .floating-cards .card-2 {
    top: 15%;
    right: 5%;
    animation: floatCard 7s ease-in-out infinite 0.5s;
  }

  .floating-cards .card-3 {
    bottom: 25%;
    left: 5%;
    animation: floatCard 8s ease-in-out infinite 1s;
  }

  .floating-cards .card-4 {
    bottom: 10%;
    right: 0;
    animation: floatCard 6.5s ease-in-out infinite 1.5s;
  }

  @keyframes floatCard {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-10px);
    }
  }

  .visual-decoration {
    position: absolute;
    bottom: -20px;
    right: 10%;
    width: 100px;
    height: 100px;
    background: linear-gradient(
      135deg,
      var(--arbol-10, rgba(5, 150, 105, 0.1)),
      var(--arbol-05, rgba(5, 150, 105, 0.05))
    );
    border-radius: 50%;
    filter: blur(40px);
    z-index: 1;
  }

  /* Stats */
  .hero-stats {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 48px;
    padding-top: 40px;
    border-top: 1px solid #e2e8f0;
    opacity: 0;
    transform: translateY(30px);
    animation: slideUp 0.6s ease forwards;
    animation-delay: 1s;
  }

  .stat {
    text-align: center;
    position: relative;
  }

  .stat-number {
    font-size: 2.5rem;
    font-weight: 800;
    color: #0f172a;
    line-height: 1;
    display: inline;
  }

  .stat-suffix {
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--arbol-claro, #059669);
  }

  .stat-label {
    display: block;
    font-size: 0.875rem;
    color: var(--text-gray, #64748b);
    margin-top: 8px;
    font-weight: 500;
  }

  .stat-divider {
    width: 1px;
    height: 50px;
    background: linear-gradient(to bottom, transparent, #e2e8f0, transparent);
  }

  /* Scroll Indicator */
  .scroll-indicator {
    position: absolute;
    bottom: 30px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    color: #94a3b8;
    font-size: 0.75rem;
    font-weight: 500;
    opacity: 0;
    animation: fadeIn 0.6s ease forwards;
    animation-delay: 1.5s;
  }

  .scroll-mouse {
    width: 24px;
    height: 40px;
    border: 2px solid #cbd5e1;
    border-radius: 12px;
    position: relative;
  }

  .scroll-wheel {
    position: absolute;
    top: 8px;
    left: 50%;
    transform: translateX(-50%);
    width: 4px;
    height: 8px;
    background: var(--arbol-claro, #059669);
    border-radius: 2px;
    animation: scrollWheel 1.5s ease-in-out infinite;
  }

  @keyframes scrollWheel {
    0%,
    100% {
      transform: translateX(-50%) translateY(0);
      opacity: 1;
    }
    50% {
      transform: translateX(-50%) translateY(8px);
      opacity: 0.3;
    }
  }

  @keyframes slideUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Mobile */
  @media (max-width: 992px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .hero-content {
      text-align: center;
    }

    .hero-title {
      font-size: clamp(1.75rem, 5vw, 2.5rem);
    }

    .hero-features {
      justify-content: center;
    }

    .hero-actions {
      justify-content: center;
    }

    .hero-visual {
      height: 300px;
      order: -1;
    }

    .main-card {
      height: 200px;
    }

    .floating-cards .floating-card {
      padding: 10px 14px;
    }

    .floating-cards .floating-card span {
      display: none;
    }

    .floating-cards .card-1 {
      top: 0;
      left: -5%;
    }
    .floating-cards .card-2 {
      top: 0;
      right: -5%;
    }
    .floating-cards .card-3 {
      bottom: 20%;
      left: -5%;
    }
    .floating-cards .card-4 {
      bottom: 20%;
      right: -5%;
    }

    .carousel-slide {
      height: 300px;
    }

    .carousel-indicator {
      width: 6px;
      height: 6px;
    }

    .carousel-indicator.active {
      width: 20px;
    }
  }

  @media (max-width: 768px) {
    .hero {
      padding-top: 60px;
      padding-bottom: 80px;
    }

    .hero-stats {
      flex-direction: column;
      gap: 24px;
    }

    .stat-divider {
      width: 60px;
      height: 1px;
    }

    .stat-number {
      font-size: 2rem;
    }

    .scroll-indicator {
      display: none;
    }

    .shape {
      display: none;
    }
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const stats = document.querySelectorAll(".stat[data-count]");

    const animateCounter = (element: HTMLElement, target: number) => {
      const numberEl = element.querySelector(".stat-number") as HTMLElement;
      const duration = 2000;
      const steps = 60;
      const increment = target / steps;
      let current = 0;

      const timer = setInterval(() => {
        current += increment;
        if (current >= target) {
          numberEl.textContent = target.toString();
          clearInterval(timer);
        } else {
          numberEl.textContent = Math.floor(current).toString();
        }
      }, duration / steps);
    };

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const target = parseInt(
              (entry.target as HTMLElement).dataset.count || "0",
            );
            animateCounter(entry.target as HTMLElement, target);
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.5 },
    );

    stats.forEach((stat) => observer.observe(stat));

    const slides = document.querySelectorAll(".carousel-slide");
    const indicators = document.querySelectorAll(".carousel-indicator");
    let currentSlide = 0;
    let rotationInterval: ReturnType<typeof setInterval>;

    const showSlide = (index: number) => {
      slides.forEach((s) => s.classList.remove("active"));
      indicators.forEach((i) => i.classList.remove("active"));
      slides[index].classList.add("active");
      indicators[index].classList.add("active");
      currentSlide = index;
    };

    const nextSlide = () => {
      const next = (currentSlide + 1) % slides.length;
      showSlide(next);
    };

    rotationInterval = setInterval(nextSlide, 5000);

    indicators.forEach((ind, idx) => {
      ind.addEventListener("click", () => {
        clearInterval(rotationInterval);
        showSlide(idx);
        rotationInterval = setInterval(nextSlide, 5000);
      });
    });
  });
</script>
