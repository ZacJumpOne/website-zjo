---
import { Button } from "antd";
import {
  MessageOutlined,
  WhatsAppOutlined,
} from "@ant-design/icons";
---

<section class="feedback" id="contacto">
  <div class="container">
    <div class="feedback-header" data-animate>
      <span class="feedback-emoji">
        <MessageOutlined />
      </span>
      <h2 class="feedback-title">La retro-alimentación es importante</h2>
      <p class="feedback-description">Ayúdanos a mejorar nuestros servicios</p>
    </div>

    <div class="feedback-channels">
      <!-- Formulario Email -->
      <div class="channel-form">
        <h3 class="channel-title">Envíanos un correo</h3>
        <form id="feedback-form">
          <input
            type="hidden"
            name="_subject"
            value="Feedback - Zero Jump One"
          />
          <input type="hidden" name="_captcha" value="true" />
          <input type="hidden" name="_template" value="table" />

          <div class="form-group">
            <label for="name">Nombre</label>
            <input
              type="text"
              id="name"
              name="nombre"
              required
              placeholder="Tu nombre"
            />
          </div>

          <div class="form-group">
            <label for="email">Correo electrónico</label>
            <input
              type="email"
              id="email"
              name="email"
              required
              placeholder="tu@correo.com"
            />
          </div>

          <div class="form-group">
            <label for="category">Categoría</label>
            <select id="category" name="categoria" required>
              <option value="sugerencia" selected>Sugerencia</option>
              <option value="servicio">Servicio</option>
              <option value="producto">Producto</option>
              <option value="soporte">Soporte</option>
              <option value="proyectos">Proyectos</option>
              <option value="otro">Otro</option>
            </select>
          </div>

          <div class="form-group">
            <label for="message">Mensaje</label>
            <textarea
              id="message"
              name="mensaje"
              rows="4"
              required
              maxlength="500"
              placeholder="Cuéntanos tu experiencia o sugerencia..."></textarea>
            <span class="char-count"><span id="char-count">0</span>/500</span>
          </div>

          <button type="submit" class="btn-submit" id="submit-btn">
            <MessageOutlined />
            <span id="btn-text">Enviar Feedback</span>
          </button>
        </form>

        <!-- Mensajes de estado -->
        <div
          class="form-message success"
          id="success-msg"
          style="display: none;"
        >
          <span class="message-icon">✓</span>
          <p class="message-title">¡Feedback enviado!</p>
          <p class="message-desc">
            Gracias por tu opinión. La recibiremos en breve.
          </p>
          <button class="btn-reset" id="reset-btn">Enviar otro</button>
        </div>

        <div class="form-message error" id="error-msg" style="display: none;">
          <span class="message-icon">✕</span>
          <p class="message-title">Algo salió mal</p>
          <p class="message-desc">No se pudo enviar. Intenta de nuevo.</p>
          <button class="btn-reset" id="retry-btn">Reintentar</button>
        </div>
      </div>

      <!-- WhatsApp Channel -->
      <div class="channel-whatsapp">
        <h3 class="channel-title">O escríbenos por WhatsApp</h3>
        <p class="whatsapp-desc">Respuesta rápida y directa</p>
        <a
          href="https://wa.me/5213317490079?text=%5BFEEDBACK%5D%20Hola%2C%20quiero%20compartir%20mi%20opinión%20sobre..."
          target="_blank"
          rel="noopener noreferrer"
        >
          <Button type="default" size="large" class="btn-whatsapp">
            <WhatsAppOutlined /> Enviar por WhatsApp
          </Button>
        </a>
        <div class="whatsapp-info">
          <p>Tu mensaje incluirá la etiqueta [FEEDBACK] para seguimiento</p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById("feedback-form");
  const submitBtn = document.getElementById("submit-btn");
  const btnText = document.getElementById("btn-text");
  const successMsg = document.getElementById("success-msg");
  const errorMsg = document.getElementById("error-msg");
  const resetBtn = document.getElementById("reset-btn");
  const retryBtn = document.getElementById("retry-btn");
  const categorySelect = document.getElementById("category");

  // Read ?cat= parameter from URL and change category
  const params = new URLSearchParams(window.location.search);
  const catParam = params.get("cat");
  if (catParam && categorySelect) {
    for (const option of categorySelect.options) {
      if (option.value === catParam) {
        categorySelect.value = catParam;
        break;
      }
    }
  }

  // Check sessionStorage for cross-page navigation (Contacto from other pages)
  const storedCat = sessionStorage.getItem("feedback-category");
  if (storedCat && categorySelect) {
    for (const option of categorySelect.options) {
      if (option.value === storedCat) {
        categorySelect.value = storedCat;
        break;
      }
    }
    sessionStorage.removeItem("feedback-category");
  }

  // Strip HTML tags from text input (security)
  function stripHTML(str) {
    const temp = document.createElement("div");
    temp.textContent = str;
    return temp.textContent;
  }

  // Character counter for message
  const messageInput = document.getElementById("message");
  const charCount = document.getElementById("char-count");
  if (messageInput && charCount) {
    messageInput.addEventListener("input", () => {
      charCount.textContent = messageInput.value.length;
    });
  }

  // Listen for custom event from header nav links
  window.addEventListener("set-feedback-category", (e) => {
    const cat = e.detail;
    if (cat && categorySelect) {
      for (const option of categorySelect.options) {
        if (option.value === cat) {
          categorySelect.value = cat;
          break;
        }
      }
    }
    // Auto-focus on name field after smooth scroll completes
    setTimeout(() => {
      const nameInput = document.getElementById("name");
      if (nameInput) nameInput.focus();
    }, 600);

    // Dynamic placeholder based on category
    if (cat === "proyectos" && messageInput) {
      messageInput.placeholder = "Cuéntanos que tienes en mente, juntos podemos lograrlo.";
    }
  });

  // Reset category when section leaves the viewport
  const feedbackSection = document.querySelector(".feedback");
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting && categorySelect) {
          categorySelect.value = "sugerencia";
        }
      });
    },
    { threshold: 0 },
  );

  if (feedbackSection) observer.observe(feedbackSection);

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();

    // Loading state
    submitBtn.disabled = true;
    btnText.textContent = "Enviando...";

    const formData = new FormData(form);
    const data = Object.fromEntries(formData.entries());

    // Sanitize all text fields - strip any HTML tags
    Object.keys(data).forEach((key) => {
      if (typeof data[key] === "string") {
        data[key] = stripHTML(data[key].trim());
      }
    });

    // Validate message length
    if (data.mensaje && data.mensaje.length > 2000) {
      submitBtn.disabled = false;
      btnText.textContent = "Enviar Feedback";
      alert("El mensaje no debe exceder 2000 caracteres.");
      return;
    }

    // Validate name is not just whitespace
    if (!data.nombre || data.nombre.length < 2) {
      submitBtn.disabled = false;
      btnText.textContent = "Enviar Feedback";
      alert("Por favor ingresa un nombre válido.");
      return;
    }

    try {
      const response = await fetch(
        "https://formsubmit.co/ajax/soporte@zerojumpone.com",
        {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            Accept: "application/json",
          },
          body: JSON.stringify(data),
        },
      );

      const result = await response.json();

      if (result.success === true || response.ok) {
        form.style.display = "none";
        successMsg.style.display = "block";
      } else {
        throw new Error(result.message || "Error desconocido");
      }
    } catch (error) {
      form.style.display = "none";
      errorMsg.style.display = "block";
    }
  });

  resetBtn?.addEventListener("click", () => {
    form?.reset();
    form!.style.display = "block";
    successMsg.style.display = "none";
    submitBtn.disabled = false;
    btnText.textContent = "Enviar Feedback";
  });

  retryBtn?.addEventListener("click", () => {
    form!.style.display = "block";
    errorMsg.style.display = "none";
    submitBtn.disabled = false;
    btnText.textContent = "Enviar Feedback";
  });

  // Section header animation
  const animateObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("animate");
        }
      });
    },
    { threshold: 0.3 },
  );

  document
    .querySelectorAll("[data-animate]")
    .forEach((el) => animateObserver.observe(el));
</script>

<style>
  .feedback {
    background: linear-gradient(135deg, var(--primary), var(--primary-dark));
    padding: 80px 20px;
  }

  .container {
    max-width: 1000px;
    margin: 0 auto;
  }

  .feedback-header {
    text-align: center;
    margin-bottom: 48px;
    opacity: 0;
    transform: translateY(30px);
    transition:
      opacity 0.6s ease,
      transform 0.6s ease;
  }

  .feedback-header.animate {
    opacity: 1;
    transform: translateY(0);
  }

  .feedback-emoji {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 72px;
    height: 72px;
    background: rgba(255, 255, 255, 0.2);
    border-radius: 50%;
    margin-bottom: 24px;
    font-size: 2rem;
    color: white;
  }

  .feedback-title {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    color: white;
    margin-bottom: 16px;
    font-weight: 700;
  }

  .feedback-description {
    font-size: 1.125rem;
    color: rgba(255, 255, 255, 0.9);
    margin-bottom: 0;
  }

  .feedback-channels {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 32px;
    align-items: start;
  }

  /* Formulario */
  .channel-form {
    background: white;
    border-radius: 16px;
    padding: 32px;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.12);
    position: relative;
    min-height: 400px;
  }

  .channel-title {
    font-size: 1.25rem;
    color: #1e293b;
    margin-bottom: 24px;
    font-weight: 700;
  }

  .form-group {
    margin-bottom: 20px;
  }

  .form-group label {
    display: block;
    font-size: 0.875rem;
    font-weight: 600;
    color: #475569;
    margin-bottom: 6px;
  }

  .form-group input,
  .form-group select,
  .form-group textarea {
    width: 100%;
    padding: 10px 14px;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    font-size: 0.95rem;
    font-family:
      "Inter",
      -apple-system,
      BlinkMacSystemFont,
      sans-serif;
    color: #1e293b;
    background: #f8fafc;
    transition: all 0.2s ease;
    box-sizing: border-box;
  }

  .form-group input:focus,
  .form-group select:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: var(--arbol-obscuro);
    background: white;
    box-shadow:
      0 0 0 3px rgba(5, 150, 105, 0.15),
      0 4px 12px rgba(5, 150, 105, 0.08);
    transition: all 0.3s ease;
  }

  .form-group textarea {
    resize: vertical;
    min-height: 100px;
  }

  .char-count {
    display: block;
    text-align: right;
    font-size: 0.75rem;
    color: #94a3b8;
    margin-top: 4px;
  }

  .btn-submit {
    width: 100%;
    padding: 12px 20px;
    font-weight: 600;
    font-size: 0.85rem;
    border-radius: 10px;
    background: linear-gradient(135deg, #f0fdf4, #ecfdf5);
    color: var(--arbol-claro);
    border: 1px solid rgba(5, 150, 105, 0.15);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    transition: all 0.3s ease;
  }

  .btn-submit:hover:not(:disabled) {
    background: var(--arbol-obscuro);
    color: #fff;
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(5, 150, 105, 0.25);
    border-color: transparent;
  }

  .btn-submit:disabled {
    opacity: 0.7;
    cursor: not-allowed;
  }

  /* Mensajes de estado */
  .form-message {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    text-align: center;
    width: 80%;
  }

  .message-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    font-size: 1.5rem;
    margin-bottom: 16px;
  }

  .form-message.success .message-icon {
    background: #dcfce7;
    color: #16a34a;
  }

  .form-message.error .message-icon {
    background: #fee2e2;
    color: #dc2626;
  }

  .message-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: #1e293b;
    margin-bottom: 8px;
  }

  .message-desc {
    font-size: 0.95rem;
    color: #64748b;
    margin-bottom: 24px;
  }

  .btn-reset {
    padding: 10px 24px;
    font-weight: 600;
    font-size: 0.9rem;
    border-radius: 8px;
    border: 1px solid #e2e8f0;
    background: white;
    color: #475569;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .btn-reset:hover {
    border-color: #3aba4a;
    color: #16a34a;
  }

  /* WhatsApp */
  .channel-whatsapp {
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 16px;
    padding: 32px;
    text-align: center;
    backdrop-filter: blur(8px);
  }

  .channel-whatsapp .channel-title {
    color: white;
  }

  .whatsapp-desc {
    color: rgba(255, 255, 255, 0.85);
    font-size: 0.95rem;
    margin-bottom: 24px;
  }

  .channel-whatsapp :global(.ant-btn) {
    height: 52px;
    padding: 0 28px;
    font-weight: 600;
    font-size: 1rem;
    border-radius: 10px;
    background: #25d366;
    color: white;
    border: none;
    box-shadow: 0 4px 14px rgba(37, 211, 102, 0.3);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    cursor: pointer;
  }

  .channel-whatsapp :global(.ant-btn:hover) {
    background: #20bd5a;
    color: white;
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(37, 211, 102, 0.4);
  }

  .whatsapp-info {
    margin-top: 20px;
    padding-top: 16px;
    border-top: 1px solid rgba(255, 255, 255, 0.15);
  }

  .whatsapp-info p {
    color: rgba(255, 255, 255, 0.6);
    font-size: 0.8rem;
    margin: 0;
  }

  @media (max-width: 768px) {
    .feedback {
      padding: 60px 16px;
    }

    .feedback-channels {
      grid-template-columns: 1fr;
    }

    .channel-form {
      padding: 24px;
      min-height: auto;
    }

    .channel-whatsapp {
      padding: 24px;
    }

    .form-message {
      position: relative;
      top: auto;
      left: auto;
      transform: none;
      width: 100%;
    }
  }
</style>
