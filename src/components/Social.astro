---
import {
  FacebookOutlined,
  TwitterOutlined,
  YoutubeOutlined,
  LinkedinOutlined,
  InstagramOutlined,
  XOutlined,
} from "@ant-design/icons";

const socialLinks = [
  {
    name: "Facebook",
    icon: "FacebookOutlined",
    href: "https://www.facebook.com/ZeroJumpOne",
    size: "large",
  },
  {
    name: "Twitter",
    icon: "XOutlined",
    href: "https://twitter.com/ZeroJumpOne",
    size: "small",
  },
  {
    name: "YouTube",
    icon: "YoutubeOutlined",
    href: "https://www.youtube.com/channel/UCq_l30b7vU3CGOCmS3rr1vQ",
    size: "small",
  },
  {
    name: "LinkedIn",
    icon: "LinkedinOutlined",
    href: "https://www.linkedin.com/in/isaac-hdez-castro-32570387/",
    size: "small",
  },
  {
    name: "Instagram",
    icon: "InstagramOutlined",
    href: "https://www.instagram.com/zerojumpone/",
    size: "small",
  },
];
---

<section class="social">
  <!-- Diagonal decorative shape -->
  <div class="social-diagonal"></div>
  <div class="social-bg-pattern"></div>

  <div class="container">
    <div class="social-split">
      <!-- Left: text -->
      <div class="social-text">
        <span class="social-tag">Conecta con nosotros</span>
        <h2 class="social-title" data-animate>
          Un paso más<br />cerca de ti
        </h2>
        <p class="social-description" data-animate>
          Síguenos en redes sociales para estar al día con novedades, tips y
          actualizaciones de Zero Jump One.
        </p>
        <div class="social-cta-hint" data-animate>
          <span>Elige tu red favorita</span>
          <div class="hint-arrow">→</div>
        </div>
      </div>

      <!-- Right: asymmetric social grid -->
      <div class="social-grid">
        {
          socialLinks.map((social, index) => (
            <a
              href={social.href}
              target="_blank"
              rel="noopener noreferrer"
              class={`social-link ${social.size}`}
              style={`--delay: ${index * 0.1}s`}
              data-animate
            >
              <span class="social-icon">
                {social.icon === "FacebookOutlined" && <FacebookOutlined />}
                {social.icon === "XOutlined" && <XOutlined />}
                {social.icon === "YoutubeOutlined" && <YoutubeOutlined />}
                {social.icon === "LinkedinOutlined" && <LinkedinOutlined />}
                {social.icon === "InstagramOutlined" && <InstagramOutlined />}
              </span>
              <span class="social-name">{social.name}</span>
              <div class="link-glow" />
            </a>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .social {
    background: linear-gradient(135deg, #f0fdf4, #ecfdf5 40%, #fff);
    padding: 100px 20px;
    position: relative;
    overflow: hidden;
  }

  .social-diagonal {
    position: absolute;
    top: 0;
    left: 35%;
    width: 200px;
    height: 100%;
    background: linear-gradient(
      105deg,
      transparent 0%,
      rgba(5, 150, 105, 0.06) 50%,
      transparent 100%
    );
    transform: skew(-8deg);
    pointer-events: none;
  }

  .social-bg-pattern {
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(
        circle at 10% 20%,
        rgba(16, 185, 129, 0.04) 1px,
        transparent 1px
      ),
      radial-gradient(
        circle at 80% 80%,
        rgba(5, 150, 105, 0.03) 1px,
        transparent 1px
      );
    background-size:
      60px 60px,
      80px 80px;
    pointer-events: none;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    position: relative;
    z-index: 2;
  }

  .social-split {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 64px;
    align-items: center;
  }

  .social-text {
    padding-right: 24px;
  }

  .social-tag {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--social-green, #059669);
    background: linear-gradient(
      135deg,
      rgba(5, 150, 105, 0.1),
      rgba(16, 185, 129, 0.08)
    );
    padding: 6px 14px;
    border-radius: 50px;
    margin-bottom: 20px;
  }

  .social-title {
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 800;
    color: #0f172a;
    line-height: 1.15;
    margin-bottom: 20px;
    letter-spacing: -0.02em;
  }

  .social-description {
    font-size: 1.05rem;
    color: #64748b;
    line-height: 1.7;
    margin-bottom: 28px;
  }

  .social-cta-hint {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--social-green, #059669);
    opacity: 0.8;
  }

  .hint-arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    background: rgba(5, 150, 105, 0.1);
    border-radius: 50%;
    font-size: 0.85rem;
    animation: hintBounce 1.5s ease-in-out infinite;
  }

  @keyframes hintBounce {
    0%,
    100% {
      transform: translate(0);
    }
    50% {
      transform: translate(6px);
    }
  }

  /* Social Grid */
  .social-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: auto auto;
    gap: 16px;
  }

  .social-link {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 24px 16px;
    background: #fff;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    text-decoration: none;
    transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
    overflow: hidden;
    animation: fadeInUp 0.5s ease backwards;
    animation-delay: var(--delay);
  }

  .social-link.large {
    grid-column: 1 / 3;
    padding: 32px 24px;
    flex-direction: row;
    gap: 16px;
    background: linear-gradient(135deg, #f0fdf4, #fff);
    border-color: rgba(5, 150, 105, 0.2);
  }

  .social-link.large .social-icon {
    font-size: 2rem;
    width: 56px;
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(
      135deg,
      var(--social-green, #059669),
      var(--social-green-light, #10b981)
    );
    color: #fff;
    border-radius: 14px;
    transition: all 0.3s ease;
  }

  .social-link.large .social-name {
    font-size: 1rem;
  }

  .social-link.small {
    padding: 20px 12px;
  }

  .social-link.small .social-icon {
    font-size: 1.5rem;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--social-bg-light, #f0fdf4);
    color: var(--social-green, #059669);
    border-radius: 12px;
    transition: all 0.3s ease;
  }

  .social-link:hover {
    transform: translateY(-6px);
    box-shadow: 0 16px 40px -8px rgba(5, 150, 105, 0.2);
    border-color: rgba(5, 150, 105, 0.3);
  }

  .social-link:hover .social-icon {
    transform: scale(1.1) rotate(-5deg);
  }

  .social-link.small:hover .social-icon {
    background: linear-gradient(
      135deg,
      var(--social-green, #059669),
      var(--social-green-light, #10b981)
    );
    color: #fff;
    transform: scale(1.15) rotate(5deg);
  }

  .social-link:hover .link-glow {
    opacity: 1;
  }

  .social-name {
    font-size: 0.8rem;
    font-weight: 700;
    color: #334155;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    transition: color 0.3s ease;
  }

  .social-link:hover .social-name {
    color: var(--social-green, #059669);
  }

  .link-glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      circle at center,
      rgba(5, 150, 105, 0.08),
      transparent 70%
    );
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }

  [data-animate] {
    opacity: 0;
    transform: translateY(20px);
    transition:
      opacity 0.6s ease,
      transform 0.6s ease;
  }

  [data-animate].animate {
    opacity: 1;
    transform: translateY(0);
  }

  @media (max-width: 992px) {
    .social-split {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .social-text {
      padding-right: 0;
      text-align: center;
    }

    .social-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .social-link.large {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 768px) {
    .social {
      padding: 60px 16px;
    }

    .social-title {
      font-size: 1.75rem;
    }

    .social-grid {
      grid-template-columns: 1fr 1fr;
    }

    .social-link {
      padding: 16px 12px;
    }

    .social-link.large {
      padding: 20px 16px;
    }
  }
</style>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("animate");
        }
      });
    },
    { threshold: 0.2 },
  );

  document
    .querySelectorAll("[data-animate]")
    .forEach((el) => observer.observe(el));
</script>
