---
import {
  MonitorOutlined,
  CustomerServiceOutlined,
  ControlOutlined,
  ArrowRightOutlined,
} from "@ant-design/icons";

const services = [
  {
    iconName: "MonitorOutlined",
    title: "Monitoreo",
    description:
      "Control y supervision por nuestro personal de las actvidades configuradas para su empresa.",
    features: [
      "Tareas automatizadas",
      "Respaldos Diarios",
      "Integridad de la base de datos",
    ],
    spotlight: true,
  },
  {
    iconName: "CustomerServiceOutlined",
    title: "Respuesta",
    description:
      "Atencion inmediata y solución efectiva a cada una de sus necesidades. Soporte especializado 24/7",
    features: [
      "Soporte dedicado",
      "Tiempo de respuesta rapido",
      "Atencion personalizada",
    ],
    accent: "green",
  },
  {
    iconName: "ControlOutlined",
    title: "Control",
    description:
      "Ya no mas preocupaciones, ahora su información al momento y en el lugar donde la necesita.",
    features: [
      "Ahorro de tiempo y recursos",
      "Integración con sus procesos ",
      "Información siempre disponible",
    ],
    accent: "emerald",
  },
];
---

<section class="services" id="servicios">
  <div class="container">
    <div class="section-header" data-animate>
      <span class="section-label">Servicios</span>
      <h2 class="section-title">Tu Mejor Eleccion</h2>
      <p class="section-subtitle">
        Monitoreo, Respuesta y Control, tres pilares fundamentales para el exito
        de tu negocio,
      </p>
    </div>

    <!-- Spotlight: Monitoreo (horizontal, asymmetric, bleeds) -->
    <div class="spotlight" data-tilt>
      <div class="spotlight-bleed"></div>
      <div class="spotlight-content">
        <div class="spotlight-text">
          <div class="spotlight-icon-wrapper">
            <div class="spotlight-icon-bg"></div>
            <div class="spotlight-icon">
              <MonitorOutlined />
            </div>
          </div>
          <h3 class="spotlight-title">{services[0].title}</h3>
          <p class="spotlight-description">
            {services[0].description}
          </p>
          <ul class="spotlight-features">
            {
              services[0].features.map((feature) => (
                <li class="feature-item">
                  <svg
                    class="feature-check"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <polyline points="20 6 9 17 4 12" />
                  </svg>
                  {feature}
                </li>
              ))
            }
          </ul>
          <a href="#portafolio" class="spotlight-cta">
            <span>Explorar soluciones</span>
            <div class="cta-icon"><ArrowRightOutlined /></div>
            <div class="btn-shine"></div>
          </a>
        </div>
        <div class="spotlight-visual">
          <div class="panel-dashboard">
            {services[0].features.map((feature, i) => (
              <div class="panel-item" style={`--stagger: ${i * 0.15}s`}>
                <div class="panel-icon">
                  <svg class="panel-check-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <polyline points="20 6 9 17 4 12" />
                  </svg>
                </div>
                <div class="panel-info">
                  <span class="panel-label">{feature}</span>
                  <div class="panel-bar">
                    <div class="panel-fill" style="--fill: 100%"></div>
                  </div>
                </div>
                <span class="panel-value">100%</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>

    <!-- Secondary Cards: Respuesta + Control -->
    <div class="secondary-grid">
      {
        services.slice(1).map((service, index) => (
          <div
            class={`secondary-card ${service.accent}`}
            data-tilt
            style={`--delay: ${(index + 1) * 0.15}s`}
          >
            <div class="sc-accent-bar" />
            <div class="sc-content">
              <div class="sc-icon-wrapper">
                <div class="sc-icon">
                  {service.iconName === "CustomerServiceOutlined" && (
                    <CustomerServiceOutlined />
                  )}
                  {service.iconName === "ControlOutlined" && (
                    <ControlOutlined />
                  )}
                </div>
              </div>
              <h3 class="sc-title">{service.title}</h3>
              <p class="sc-description">{service.description}</p>
              <ul class="sc-features">
                {service.features.map((feature) => (
                  <li class="sc-feature-item">
                    <svg
                      class="sc-check"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                    >
                      <polyline points="20 6 9 17 4 12" />
                    </svg>
                    {feature}
                  </li>
                ))}
              </ul>
              <a href="#portafolio" class="sc-cta">
                <span>Explorar</span>
                <div class="cta-icon">
                  <ArrowRightOutlined />
                </div>
              </a>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .services {
    background: var(
      --gradient-bg,
      linear-gradient(180deg, #fff, #f0fdf4, #fff)
    );
    padding: 120px 20px;
    position: relative;
    overflow: hidden;
  }

  .services::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, #e2e8f0, transparent);
  }

  .section-header {
    opacity: 0;
    transform: translateY(30px);
    transition:
      opacity 0.6s ease,
      transform 0.6s ease;
  }

  .section-header.animate {
    opacity: 1;
    transform: translateY(0);
  }

  .section-label {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--arbol-claro, #059669);
    background: linear-gradient(
      135deg,
      var(--arbol-10, rgba(5, 150, 105, 0.1)),
      rgba(16, 185, 129, 0.08)
    );
    padding: 6px 14px;
    border-radius: 50px;
    margin-bottom: 20px;
  }

  .section-title {
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 800;
    color: #0f172a;
    line-height: 1.15;
    margin-bottom: 20px;
    letter-spacing: -0.02em;
  }

  .section-subtitle {
    font-size: 1.05rem;
    color: #64748b;
    line-height: 1.7;
    margin-bottom: 28px;
  }

  /* Spotlight Card - Neo Dashboard */
  .spotlight {
    position: relative;
    background: linear-gradient(135deg, #fff, #f0fdf4);
    border-radius: 32px;
    padding: 48px;
    margin-bottom: 40px;
    overflow: visible;
    border: 1px solid #e2e8f0;
    transition:
      transform 0.4s ease,
      box-shadow 0.4s ease;
    animation: fadeInUp 0.8s ease backwards;
    animation-delay: 0.1s;
  }

  .spotlight:hover {
    transform: translateY(-6px);
    box-shadow: 0 20px 40px -12px rgba(0, 0, 0, 0.12);
  }

  .spotlight-bleed {
    position: absolute;
    top: -40px;
    right: -40px;
    width: 300px;
    height: 300px;
    background: radial-gradient(
      circle,
      rgba(16, 185, 129, 0.12),
      transparent 70%
    );
    border-radius: 50%;
    filter: blur(60px);
    z-index: 1;
    pointer-events: none;
    animation: pulse 4s ease-in-out infinite;
  }

  @keyframes pulse {
    0%,
    100% {
      opacity: 0.6;
      transform: scale(1);
    }
    50% {
      opacity: 1;
      transform: scale(1.1);
    }
  }

  .spotlight-content {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 48px;
    align-items: center;
    position: relative;
    z-index: 2;
  }

  .spotlight-icon-wrapper {
    position: relative;
    width: 64px;
    height: 64px;
    margin-bottom: 20px;
  }

  .spotlight-icon-bg {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      135deg,
      var(--arbol-claro, #059669),
      var(--arbol-claro, #10b981)
    );
    border-radius: 18px;
    transform: rotate(-6deg);
    transition: transform 0.4s ease;
  }

  .spotlight:hover .spotlight-icon-bg {
    transform: rotate(0) scale(1.05);
  }

  .spotlight-icon {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.75rem;
    color: #fff;
  }

  .spotlight-title {
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    font-weight: 800;
    color: #0f172a;
    margin-bottom: 12px;
    letter-spacing: -0.02em;
  }

  .spotlight-description {
    font-size: 1.05rem;
    color: #475569;
    line-height: 1.7;
    margin-bottom: 24px;
  }

  .spotlight-features {
    list-style: none;
    margin-bottom: 32px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .spotlight .feature-item {
    display: flex;
    align-items: center;
    gap: 12px;
    color: #334155;
    font-size: 0.95rem;
    font-weight: 500;
  }

  .spotlight .feature-check {
    width: 20px;
    height: 20px;
    color: #10b981;
    flex-shrink: 0;
    filter: drop-shadow(0 0 4px rgba(16, 185, 129, 0.5));
  }

  .spotlight-cta {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 14px 28px;
    background: linear-gradient(135deg, #10b981, #059669);
    border-radius: 14px;
    color: #fff;
    font-weight: 700;
    font-size: 0.95rem;
    transition: all 0.3s ease;
    overflow: hidden;
    box-shadow:
      0 4px 14px rgba(16, 185, 129, 0.4),
      0 0 20px rgba(16, 185, 129, 0.2);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .spotlight-cta:hover {
    transform: translateY(-3px);
    box-shadow:
      0 8px 28px rgba(16, 185, 129, 0.5),
      0 0 40px rgba(16, 185, 129, 0.3);
  }

  .spotlight-cta .cta-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    background: rgba(255, 255, 255, 0.2);
    border-radius: 6px;
    transition: transform 0.3s ease;
  }

  .spotlight-cta:hover .cta-icon {
    transform: translate(4px) rotate(45deg);
  }

  .btn-shine {
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(255, 255, 255, 0.3),
      transparent
    );
    transition: left 0.5s ease;
    pointer-events: none;
  }

  .spotlight-cta:hover .btn-shine {
    left: 100%;
  }

  /* Panel Dashboard */
  .spotlight-visual {
    position: relative;
    height: 320px;
  }

  .panel-dashboard {
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .panel-item {
    display: flex;
    align-items: center;
    gap: 14px;
    background: #fff;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    padding: 16px 20px;
    animation: fadeInUp 0.5s ease backwards;
    animation-delay: var(--stagger);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .panel-item:hover {
    transform: translateX(4px);
    box-shadow: 0 4px 16px rgba(5, 150, 105, 0.08);
    border-color: rgba(5, 150, 105, 0.2);
  }

  .panel-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    background: linear-gradient(135deg, #ecfdf5, #d1fae5);
    border-radius: 12px;
    flex-shrink: 0;
  }

  .panel-check-icon {
    width: 18px;
    height: 18px;
    color: var(--arbol-claro);
  }

  .panel-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
  }

  .panel-label {
    font-size: 0.8rem;
    font-weight: 600;
    color: #334155;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .panel-bar {
    height: 5px;
    background: #f1f5f9;
    border-radius: 3px;
    overflow: hidden;
  }

  .panel-fill {
    height: 100%;
    width: var(--fill, 100%);
    background: linear-gradient(90deg, var(--arbol-claro), #34d399);
    border-radius: 3px;
    animation: fillGrow 1.2s ease backwards;
    animation-delay: var(--stagger);
  }

  @keyframes fillGrow {
    from { width: 0; }
  }

  .panel-value {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--arbol-claro);
    flex-shrink: 0;
  }

  /* Secondary Grid */
  .secondary-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 28px;
  }

  .secondary-card {
    position: relative;
    background: #fff;
    border-radius: 24px;
    padding: 36px 32px;
    border: 1px solid #e2e8f0;
    transition:
      transform 0.4s ease,
      box-shadow 0.4s ease;
    animation: fadeInUp 0.6s ease backwards;
    animation-delay: var(--delay);
    overflow: hidden;
  }

  .secondary-card:first-child {
    padding-top: 44px;
  }

  .secondary-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 20px 40px -12px rgba(0, 0, 0, 0.12);
  }

  .sc-accent-bar {
    position: absolute;
    top: 0;
    left: 24px;
    right: 24px;
    height: 3px;
    border-radius: 0 0 3px 3px;
  }

  .secondary-card.green .sc-accent-bar {
    background: linear-gradient(
      90deg,
      var(--arbol-claro, #059669),
      var(--arbol-03, #34d399)
    );
  }

  .secondary-card.emerald .sc-accent-bar {
    background: linear-gradient(90deg, var(--arbol-03, #34d399), #6ee7b7);
  }

  .sc-content {
    position: relative;
    z-index: 2;
  }

  .sc-icon-wrapper {
    position: relative;
    width: 56px;
    height: 56px;
    margin-bottom: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(
      135deg,
      var(--arbol-10, rgba(5, 150, 105, 0.1)),
      rgba(16, 185, 129, 0.1)
    );
    border-radius: 16px;
    transition: transform 0.3s ease;
  }

  .secondary-card:hover .sc-icon-wrapper {
    transform: rotate(-6deg) scale(1.05);
    background: linear-gradient(
      135deg,
      rgba(5, 150, 105, 0.18),
      rgba(16, 185, 129, 0.18)
    );
  }

  .sc-icon {
    font-size: 1.5rem;
    color: var(--arbol-claro, #059669);
  }

  .sc-title {
    font-size: 1.35rem;
    font-weight: 700;
    color: #0f172a;
    margin-bottom: 10px;
    letter-spacing: -0.01em;
  }

  .sc-description {
    color: #64748b;
    font-size: 0.9rem;
    line-height: 1.7;
    margin-bottom: 20px;
  }

  .sc-features {
    list-style: none;
    margin-bottom: 24px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .sc-feature-item {
    display: flex;
    align-items: center;
    gap: 10px;
    color: #475569;
    font-size: 0.85rem;
    transition: all 0.3s ease;
  }

  .secondary-card:hover .sc-feature-item {
    transform: translateX(4px);
  }

  .sc-check {
    width: 16px;
    height: 16px;
    color: var(--arbol-claro, #10b981);
    flex-shrink: 0;
  }

  .sc-cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 12px 20px;
    background: linear-gradient(135deg, #f0fdf4, #ecfdf5);
    border-radius: 10px;
    color: var(--arbol-claro, #059669);
    font-weight: 600;
    font-size: 0.85rem;
    transition: all 0.3s ease;
    border: 1px solid rgba(5, 150, 105, 0.15);
  }

  .sc-cta:hover {
    background: var(--arbol-obscuro, #047857);
    color: #fff;
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(5, 150, 105, 0.25);
    border-color: transparent;
  }

  .sc-cta .cta-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    background: var(--arbol-10, rgba(5, 150, 105, 0.1));
    border-radius: 5px;
    transition: transform 0.3s ease;
  }

  .sc-cta:hover .cta-icon {
    background: rgba(255, 255, 255, 0.2);
    transform: translate(3px) rotate(45deg);
  }

  @media (max-width: 992px) {
    .spotlight-content {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .spotlight-visual {
      height: 280px;
    }

    .secondary-grid {
  }

  @media (max-width: 768px) {
    .services {
      padding: 80px 16px;
    }

    .spotlight {
      padding: 28px;
    }

    .spotlight-title {
      font-size: 1.5rem;
    }

    .metric-label {
      font-size: 1.5rem;
    }

    .secondary-card {
      padding: 28px 24px;
    }

    .spotlight-visual {
      height: 240px;
    }

    .secondary-card {
      padding: 24px 18px;
    }
  }

  .social-cta-hint {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--arbol-claro, #059669);
    opacity: 0.8;
  }

  .hint-arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    background: var(--arbol-10, rgba(5, 150, 105, 0.1));
    border-radius: 50%;
    font-size: 0.85rem;
    animation: hintBounce 1.5s ease-in-out infinite;
  }

  @keyframes hintBounce {
    0%,
    100% {
      transform: translate(0);
    }
    50% {
      transform: translate(6px);
    }
  }
</style>

<script>
  // Card animation observer
  const cardObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("animate");
        }
      });
    },
    { threshold: 0.2 },
  );

  document
    .querySelectorAll("[data-tilt]")
    .forEach((el) => cardObserver.observe(el));

  // Section header animation
  const headerObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("animate");
        }
      });
    },
    { threshold: 0.3 },
  );

  document
    .querySelectorAll(".section-header")
    .forEach((el) => headerObserver.observe(el));
</script>
