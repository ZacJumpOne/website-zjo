---
import {
  MonitorOutlined,
  CustomerServiceOutlined,
  ControlOutlined,
  ArrowRightOutlined,
} from "@ant-design/icons";

const services = [
  {
    iconName: "MonitorOutlined",
    title: "Monitoreo",
    description:
      "Control y supervision en tiempo real por nuestro personal de los procesos de su empresa.",
    features: [
      "Tareas automatizadas",
      "Respaldos",
      "Auditoria a la base de datos",
    ],
    spotlight: true,
    metric: { value: 99, suffix: "%", label: "Disponibilidad garantizada" },
  },
  {
    iconName: "CustomerServiceOutlined",
    title: "Respuesta",
    description:
      "Atencion inmediata y solución efectiva a cada una de sus necesidades. Soporte especializado 24/7",
    features: [
      "Soporte dedicado",
      "Tiempo de respuesta rapido",
      "Atencion personalizada",
    ],
    accent: "green",
  },
  {
    iconName: "ControlOutlined",
    title: "Control",
    description:
      "Sistemas diseñados para trabajar conjuntamente y escalar con su negocio.",
    features: [
      "Sin islas de información",
      "Integración total entre sus procesos",
      "Escalabilidad, nunca obsoleto",
    ],
    accent: "emerald",
  },
];
---

<section class="services" id="servicios">
  <div class="container">
    <div class="section-header" data-animate>
      <span class="section-label">Servicios</span>
      <h2 class="section-title">Tu Mejor Eleccion</h2>
      <p class="section-subtitle">
        Tres pilares fundamentales para el exito de tu negocio
      </p>
    </div>

    <!-- Spotlight: Monitoreo (horizontal, asymmetric, bleeds) -->
    <div class="spotlight" data-tilt>
      <div class="spotlight-bleed"></div>
      <div class="spotlight-content">
        <div class="spotlight-text">
          <div class="spotlight-icon-wrapper">
            <div class="spotlight-icon-bg"></div>
            <div class="spotlight-icon">
              <MonitorOutlined />
            </div>
          </div>
          <h3 class="spotlight-title">Monitoreo</h3>
          <p class="spotlight-description">
            Control y supervision en tiempo real por nuestro personal de los procesos de su empresa.
          </p>
          <ul class="spotlight-features">
            {services[0].features.map((feature) => (
              <li class="feature-item">
                <svg class="feature-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polyline points="20 6 9 17 4 12" />
                </svg>
                {feature}
              </li>
            ))}
          </ul>
          <a href="#portafolio" class="spotlight-cta">
            <span>Explorar soluciones</span>
            <div class="cta-icon"><ArrowRightOutlined /></div>
          </a>
        </div>
        <div class="spotlight-visual">
          <div class="visual-grid">
            <div class="visual-block vb-1">
              <div class="visual-dot"></div>
              <div class="visual-dot active"></div>
              <div class="visual-dot"></div>
            </div>
            <div class="visual-block vb-2">
              <div class="visual-bar"><div class="visual-bar-fill" style="width: 85%"></div></div>
              <div class="visual-bar"><div class="visual-bar-fill" style="width: 92%"></div></div>
              <div class="visual-bar"><div class="visual-bar-fill" style="width: 78%"></div></div>
            </div>
            <div class="visual-block vb-3">
              <span class="visual-status">Activo</span>
            </div>
          </div>
        </div>
      </div>
      <div class="spotlight-metric" data-value="99">
        <div class="metric-label"><span class="metric-number">0</span>%</div>
        <div class="metric-sub">Disponibilidad garantizada</div>
      </div>
    </div>

    <!-- Secondary Cards: Respuesta + Control -->
    <div class="secondary-grid">
      {services.slice(1).map((service, index) => (
        <div class={`secondary-card ${service.accent}`} data-tilt style={`--delay: ${(index + 1) * 0.15}s`}>
          <div class="sc-accent-bar"></div>
          <div class="sc-content">
            <div class="sc-icon-wrapper">
              <div class="sc-icon">
                {service.iconName === "CustomerServiceOutlined" && <CustomerServiceOutlined />}
                {service.iconName === "ControlOutlined" && <ControlOutlined />}
              </div>
            </div>
            <h3 class="sc-title">{service.title}</h3>
            <p class="sc-description">{service.description}</p>
            <ul class="sc-features">
              {service.features.map((feature) => (
                <li class="sc-feature-item">
                  <svg class="sc-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="20 6 9 17 4 12" />
                  </svg>
                  {feature}
                </li>
              ))}
            </ul>
            <a href="#portafolio" class="sc-cta">
              <span>Explorar</span>
              <div class="cta-icon"><ArrowRightOutlined /></div>
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .services {
    background: var(--gradient-bg, linear-gradient(180deg, #ffffff 0%, #f8fafc 100%));
    padding: 120px 20px;
    position: relative;
    overflow: hidden;
  }

  .services::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, #e2e8f0, transparent);
  }

  .section-header {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }

  .section-header.animate {
    opacity: 1;
    transform: translateY(0);
  }

  /* Spotlight Card */
  .spotlight {
    position: relative;
    background: linear-gradient(135deg, #fff, #f0fdf4);
    border-radius: 32px;
    padding: 48px;
    margin-bottom: 40px;
    overflow: visible;
    border: 1px solid rgba(5, 150, 105, 0.15);
    box-shadow: 0 20px 60px -15px rgba(5, 150, 105, 0.12), 0 8px 24px -8px rgba(0, 0, 0, 0.06);
    animation: fadeInUp 0.8s ease backwards;
    animation-delay: 0.1s;
  }

  .spotlight-bleed {
    position: absolute;
    top: -30px;
    right: -30px;
    width: 200px;
    height: 200px;
    background: radial-gradient(circle, rgba(16, 185, 129, 0.15), transparent 70%);
    border-radius: 50%;
    filter: blur(40px);
    z-index: 1;
    pointer-events: none;
  }

  .spotlight-content {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 48px;
    align-items: center;
    position: relative;
    z-index: 2;
  }

  .spotlight-icon-wrapper {
    position: relative;
    width: 64px;
    height: 64px;
    margin-bottom: 20px;
  }

  .spotlight-icon-bg {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, var(--arbol-claro, #059669), var(--arbol-claro, #10b981));
    border-radius: 18px;
    transform: rotate(-6deg);
    transition: transform 0.4s ease;
  }

  .spotlight:hover .spotlight-icon-bg {
    transform: rotate(0) scale(1.05);
  }

  .spotlight-icon {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.75rem;
    color: #fff;
  }

  .spotlight-title {
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    font-weight: 800;
    color: #0f172a;
    margin-bottom: 12px;
    letter-spacing: -0.02em;
  }

  .spotlight-description {
    font-size: 1.05rem;
    color: #475569;
    line-height: 1.7;
    margin-bottom: 24px;
  }

  .spotlight-features {
    list-style: none;
    margin-bottom: 32px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .spotlight .feature-item {
    display: flex;
    align-items: center;
    gap: 12px;
    color: #334155;
    font-size: 0.95rem;
    font-weight: 500;
  }

  .spotlight .feature-check {
    width: 20px;
    height: 20px;
    color: var(--arbol-claro, #059669);
    flex-shrink: 0;
  }

  .spotlight-cta {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 14px 28px;
    background: linear-gradient(135deg, var(--arbol-claro, #059669), var(--arbol-obscuro, #047857));
    border-radius: 14px;
    color: #fff;
    font-weight: 700;
    font-size: 0.95rem;
    transition: all 0.3s ease;
    box-shadow: 0 4px 14px rgba(5, 150, 105, 0.3);
  }

  .spotlight-cta:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 28px rgba(5, 150, 105, 0.4);
  }

  .spotlight-cta .cta-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    background: rgba(255, 255, 255, 0.2);
    border-radius: 6px;
    transition: transform 0.3s ease;
  }

  .spotlight-cta:hover .cta-icon {
    transform: translate(4px);
  }

  /* Spotlight Visual */
  .spotlight-visual {
    position: relative;
    height: 280px;
  }

  .visual-grid {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .visual-block {
    position: absolute;
    background: #fff;
    border-radius: 16px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
    border: 1px solid var(--arbol-10, rgba(5, 150, 105, 0.1));
    overflow: hidden;
  }

  .vb-1 {
    top: 0;
    right: 0;
    width: 120px;
    height: 60px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 12px;
  }

  .visual-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--arbol-claro, #10b981);
    opacity: 0.3;
  }

  .visual-dot.active {
    opacity: 1;
    box-shadow: 0 0 8px rgba(16, 185, 129, 0.5);
  }

  .vb-2 {
    top: 80px;
    left: 20px;
    right: 40px;
    height: 100px;
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .visual-bar {
    height: 12px;
    background: #f0fdf4;
    border-radius: 6px;
    overflow: hidden;
  }

  .visual-bar-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--arbol-claro, #059669), var(--arbol-claro, #10b981));
    border-radius: 6px;
  }

  .vb-3 {
    bottom: 20px;
    right: 20px;
    width: 100px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .visual-status {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--arbol-claro, #059669);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* Spotlight Metric */
  .spotlight-metric {
    position: absolute;
    bottom: -30px;
    left: 48px;
    background: linear-gradient(135deg, var(--arbol-claro, #059669), var(--arbol-claro, #10b981));
    color: #fff;
    padding: 20px 28px;
    border-radius: 20px;
    box-shadow: 0 12px 32px rgba(5, 150, 105, 0.3);
    z-index: 3;
  }

  .metric-label {
    font-size: 2rem;
    font-weight: 800;
    line-height: 1;
  }

  .metric-number {
    display: inline;
  }

  .metric-sub {
    font-size: 0.75rem;
    font-weight: 600;
    opacity: 0.9;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  /* Secondary Grid */
  .secondary-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 28px;
  }

  .secondary-card {
    position: relative;
    background: #fff;
    border-radius: 24px;
    padding: 36px 32px;
    border: 1px solid #e2e8f0;
    transition: transform 0.4s ease, box-shadow 0.4s ease;
    animation: fadeInUp 0.6s ease backwards;
    animation-delay: var(--delay);
    overflow: hidden;
  }

  .secondary-card:first-child {
    padding-top: 44px;
  }

  .secondary-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 20px 40px -12px rgba(0, 0, 0, 0.12);
  }

  .sc-accent-bar {
    position: absolute;
    top: 0;
    left: 24px;
    right: 24px;
    height: 3px;
    border-radius: 0 0 3px 3px;
  }

  .secondary-card.green .sc-accent-bar {
    background: linear-gradient(90deg, var(--arbol-claro, #059669), var(--arbol-03, #34d399));
  }

  .secondary-card.emerald .sc-accent-bar {
    background: linear-gradient(90deg, var(--arbol-03, #34d399), #6ee7b7);
  }

  .sc-content {
    position: relative;
    z-index: 2;
  }

  .sc-icon-wrapper {
    position: relative;
    width: 56px;
    height: 56px;
    margin-bottom: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, var(--arbol-10, rgba(5, 150, 105, 0.1)), rgba(16, 185, 129, 0.1));
    border-radius: 16px;
    transition: transform 0.3s ease;
  }

  .secondary-card:hover .sc-icon-wrapper {
    transform: rotate(-6deg) scale(1.05);
    background: linear-gradient(135deg, rgba(5, 150, 105, 0.18), rgba(16, 185, 129, 0.18));
  }

  .sc-icon {
    font-size: 1.5rem;
    color: var(--arbol-claro, #059669);
  }

  .sc-title {
    font-size: 1.35rem;
    font-weight: 700;
    color: #0f172a;
    margin-bottom: 10px;
    letter-spacing: -0.01em;
  }

  .sc-description {
    color: #64748b;
    font-size: 0.9rem;
    line-height: 1.7;
    margin-bottom: 20px;
  }

  .sc-features {
    list-style: none;
    margin-bottom: 24px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .sc-feature-item {
    display: flex;
    align-items: center;
    gap: 10px;
    color: #475569;
    font-size: 0.85rem;
    transition: all 0.3s ease;
  }

  .secondary-card:hover .sc-feature-item {
    transform: translateX(4px);
  }

  .sc-check {
    width: 16px;
    height: 16px;
    color: var(--arbol-claro, #10b981);
    flex-shrink: 0;
  }

  .sc-cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 12px 20px;
    background: linear-gradient(135deg, #f0fdf4, #ecfdf5);
    border-radius: 10px;
    color: var(--arbol-claro, #059669);
    font-weight: 600;
    font-size: 0.85rem;
    transition: all 0.3s ease;
    border: 1px solid rgba(5, 150, 105, 0.15);
  }

  .sc-cta:hover {
    background: linear-gradient(135deg, var(--arbol-claro, #059669), var(--arbol-obscuro, #047857));
    color: #fff;
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(5, 150, 105, 0.25);
    border-color: transparent;
  }

  .sc-cta .cta-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    background: var(--arbol-10, rgba(5, 150, 105, 0.1));
    border-radius: 5px;
    transition: transform 0.3s ease;
  }

  .sc-cta:hover .cta-icon {
    background: rgba(255, 255, 255, 0.2);
    transform: translate(3px);
  }

  @media (max-width: 992px) {
    .spotlight-content {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .spotlight-visual {
      height: 200px;
    }

    .spotlight-metric {
      position: relative;
      bottom: auto;
      left: auto;
      margin-top: 24px;
      display: inline-block;
    }

    .secondary-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 768px) {
    .services {
      padding: 80px 16px;
    }

    .spotlight {
      padding: 28px;
    }

    .spotlight-title {
      font-size: 1.5rem;
    }

    .metric-label {
      font-size: 1.5rem;
    }

    .secondary-card {
      padding: 28px 24px;
    }
  }
</style>

<script>
  // Card animation observer
  const cardObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("animate");
        }
      });
    },
    { threshold: 0.2 },
  );

  document.querySelectorAll("[data-tilt]").forEach((el) => cardObserver.observe(el));

  // Section header animation
  const headerObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("animate");
        }
      });
    },
    { threshold: 0.3 },
  );

  document.querySelectorAll(".section-header").forEach((el) => headerObserver.observe(el));

  // Metric counter animation
  const metricEl = document.querySelector(".spotlight-metric[data-value]");
  if (metricEl) {
    const metricObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const target = parseInt(entry.target.getAttribute("data-value") || "0", 10);
            const numberEl = entry.target.querySelector(".metric-number");
            if (!numberEl) return;
            const duration = 2000;
            const steps = 60;
            const increment = target / steps;
            let current = 0;

            const timer = setInterval(() => {
              current += increment;
              if (current >= target) {
                numberEl.textContent = target.toString();
                clearInterval(timer);
              } else {
                numberEl.textContent = Math.floor(current).toString();
              }
            }, duration / steps);

            metricObserver.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.5 },
    );

    metricObserver.observe(metricEl);
  }
</script>
