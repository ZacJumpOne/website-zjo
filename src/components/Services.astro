---
import {
  MonitorOutlined,
  CustomerServiceOutlined,
  ControlOutlined,
  ArrowRightOutlined,
} from "@ant-design/icons";

const services = [
  {
    iconName: "MonitorOutlined",
    title: "Monitoreo",
    description:
      "Control y supervision por nuestro personal de las actvidades configuradas para su empresa.",
    features: [
      "Tareas automatizadas",
      "Respaldos Diarios",
      "Integridad de la base de datos",
    ],
    spotlight: true,
  },
  {
    iconName: "CustomerServiceOutlined",
    title: "Respuesta",
    description:
      "Atencion inmediata y solución efectiva a cada una de sus necesidades. Soporte especializado 24/7",
    features: [
      "Soporte dedicado",
      "Tiempo de respuesta rapido",
      "Atencion personalizada",
    ],
    accent: "green",
  },
  {
    iconName: "ControlOutlined",
    title: "Control",
    description:
      "Ya no mas preocupaciones, ahora su información al momento y en el lugar donde la necesita.",
    features: [
      "Ahorro de tiempo y recursos",
      "Integración con sus procesos ",
      "Información siempre disponible",
    ],
    accent: "emerald",
  },
];
---

<section class="services" id="servicios">
  <div class="container">
    <div class="section-header" data-animate>
      <span class="section-label">Servicios</span>
      <h2 class="section-title">Tu Mejor Eleccion</h2>
      <p class="section-subtitle">
        Monitoreo, Respuesta y Control, tres pilares fundamentales para el exito
        de tu negocio,
      </p>
    </div>

    <!-- Spotlight: Monitoreo (horizontal, asymmetric, bleeds) -->
    <div class="spotlight" data-tilt>
      <div class="spotlight-bleed"></div>
      <div class="spotlight-content">
        <div class="spotlight-text">
          <div class="spotlight-icon-wrapper">
            <div class="spotlight-icon-bg"></div>
            <div class="spotlight-icon">
              <MonitorOutlined />
            </div>
          </div>
          <h3 class="spotlight-title">{services[0].title}</h3>
          <p class="spotlight-description">
            {services[0].description}
          </p>
          <ul class="spotlight-features">
            {
              services[0].features.map((feature) => (
                <li class="feature-item">
                  <svg
                    class="feature-check"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <polyline points="20 6 9 17 4 12" />
                  </svg>
                  {feature}
                </li>
              ))
            }
          </ul>
          <a href="#portafolio" class="spotlight-cta">
            <span>Explorar soluciones</span>
            <div class="cta-icon"><ArrowRightOutlined /></div>
          </a>
        </div>
        <div class="spotlight-visual">
          <div class="terminal">
            <div class="terminal-bar">
              <span class="terminal-dot red"></span>
              <span class="terminal-dot yellow"></span>
              <span class="terminal-dot green"></span>
              <span class="terminal-title">ZJOne-monitor --status</span>
            </div>
            <div class="terminal-body">
              <div class="terminal-line prompt">
                <span class="prompt-sign">$</span>
                <span class="prompt-cmd">ZJOne-monitor --watch</span>
                <span class="cursor">▊</span>
              </div>
              {
                services[0].features.map((feature, i) => (
                  <div
                    class="terminal-line log"
                    style={`--stagger: ${i * 0.4}s`}
                  >
                    <span class="log-check">✓</span>
                    <span class="log-text">{feature}</span>
                    <span class="log-status" data-counter="100">
                      0%
                    </span>
                  </div>
                ))
              }
              <div class="terminal-line status-line" style="--stagger: 1.6s">
                <span class="status-fill full"></span>
                <span class="status-label">SISTEMA OPERATIVO</span>
              </div>
              <div class="terminal-line uptime-line" style="--stagger: 2.0s">
                <span class="status-fill partial"></span>
                <span class="status-label">Uptime 99.9%</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Secondary Cards: Respuesta + Control -->
    <div class="secondary-grid">
      {
        services.slice(1).map((service, index) => (
          <div
            class={`secondary-card ${service.accent}`}
            data-tilt
            style={`--delay: ${(index + 1) * 0.15}s`}
          >
            <div class="sc-accent-bar" />
            <div class="sc-content">
              <div class="sc-icon-wrapper">
                <div class="sc-icon">
                  {service.iconName === "CustomerServiceOutlined" && (
                    <CustomerServiceOutlined />
                  )}
                  {service.iconName === "ControlOutlined" && (
                    <ControlOutlined />
                  )}
                </div>
              </div>
              <h3 class="sc-title">{service.title}</h3>
              <p class="sc-description">{service.description}</p>
              <ul class="sc-features">
                {service.features.map((feature) => (
                  <li class="sc-feature-item">
                    <svg
                      class="sc-check"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                    >
                      <polyline points="20 6 9 17 4 12" />
                    </svg>
                    {feature}
                  </li>
                ))}
              </ul>
              <a href="#portafolio" class="sc-cta">
                <span>Explorar</span>
                <div class="cta-icon">
                  <ArrowRightOutlined />
                </div>
              </a>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .services {
    background: var(
      --gradient-bg,
      linear-gradient(180deg, #fff, #f0fdf4, #fff)
    );
    padding: 120px 20px;
    position: relative;
    overflow: hidden;
  }

  .services::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, #e2e8f0, transparent);
  }

  .section-header {
    opacity: 0;
    transform: translateY(30px);
    transition:
      opacity 0.6s ease,
      transform 0.6s ease;
  }

  .section-header.animate {
    opacity: 1;
    transform: translateY(0);
  }

  .section-label {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--arbol-claro, #059669);
    background: linear-gradient(
      135deg,
      var(--arbol-10, rgba(5, 150, 105, 0.1)),
      rgba(16, 185, 129, 0.08)
    );
    padding: 6px 14px;
    border-radius: 8px;
    margin-bottom: 20px;
  }

  .section-title {
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 800;
    color: #0f172a;
    line-height: 1.15;
    margin-bottom: 20px;
    letter-spacing: -0.02em;
  }

  .section-subtitle {
    font-size: 1.05rem;
    color: #64748b;
    line-height: 1.7;
    margin-bottom: 28px;
  }

  /* Spotlight Card - Neo Dashboard */
  .spotlight {
    position: relative;
    background: #fff;
    border-radius: 32px;
    padding: 48px;
    margin-bottom: 40px;
    overflow: visible;
    border: 1px solid #e2e8f0;
    transition:
      transform 0.4s ease,
      box-shadow 0.4s ease;
    animation: fadeInUp 0.8s ease backwards;
    animation-delay: 0.1s;
  }

  .spotlight:hover {
    transform: translateY(-6px);
    box-shadow: 0 20px 40px -12px rgba(0, 0, 0, 0.12);
  }

  .spotlight-bleed {
    position: absolute;
    top: -40px;
    right: -40px;
    width: 300px;
    height: 300px;
    background: radial-gradient(
      circle,
      rgba(16, 185, 129, 0.12),
      transparent 70%
    );
    border-radius: 50%;
    filter: blur(60px);
    z-index: 1;
    pointer-events: none;
    animation: pulse 4s ease-in-out infinite;
  }

  @keyframes pulse {
    0%,
    100% {
      opacity: 0.6;
      transform: scale(1);
    }
    50% {
      opacity: 1;
      transform: scale(1.1);
    }
  }

  .spotlight-content {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 48px;
    align-items: center;
    position: relative;
    z-index: 2;
  }

  .spotlight-icon-wrapper {
    position: relative;
    width: 64px;
    height: 64px;
    margin-bottom: 20px;
  }

  .spotlight-icon-bg {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      135deg,
      var(--arbol-10, rgba(5, 150, 105, 0.1)),
      rgba(16, 185, 129, 0.1)
    );
    border-radius: 18px;
    transition:
      transform 0.4s ease,
      background 0.3s ease;
  }

  .spotlight:hover .spotlight-icon-bg {
    transform: rotate(-6deg) scale(1.05);
    background: linear-gradient(
      135deg,
      rgba(5, 150, 105, 0.18),
      rgba(16, 185, 129, 0.18)
    );
  }

  .spotlight-icon {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.75rem;
    color: var(--arbol-claro, #059669);
  }

  .spotlight-title {
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    font-weight: 800;
    color: #0f172a;
    margin-bottom: 12px;
    letter-spacing: -0.02em;
  }

  .spotlight-description {
    font-size: 1.05rem;
    color: #475569;
    line-height: 1.7;
    margin-bottom: 24px;
  }

  .spotlight-features {
    list-style: none;
    margin-bottom: 32px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .spotlight .feature-item {
    display: flex;
    align-items: center;
    gap: 12px;
    color: #334155;
    font-size: 0.95rem;
    font-weight: 500;
  }

  .spotlight .feature-check {
    width: 20px;
    height: 20px;
    color: #10b981;
    flex-shrink: 0;
    filter: drop-shadow(0 0 4px rgba(16, 185, 129, 0.5));
  }

  .spotlight-cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 12px 20px;
    background: linear-gradient(135deg, #f0fdf4, #ecfdf5);
    border-radius: 10px;
    color: var(--arbol-claro);
    font-weight: 600;
    font-size: 0.85rem;
    transition: all 0.3s ease;
    border: 1px solid rgba(5, 150, 105, 0.15);
  }

  .spotlight-cta:hover {
    background: var(--arbol-obscuro);
    color: #fff;
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(5, 150, 105, 0.25);
    border-color: transparent;
  }

  .spotlight-cta .cta-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    background: var(--arbol-10, rgba(5, 150, 105, 0.1));
    border-radius: 5px;
    transition: transform 0.3s ease;
  }

  .spotlight-cta:hover .cta-icon {
    background: rgba(255, 255, 255, 0.2);
    transform: translate(3px) rotate(45deg);
  }

  /* Terminal Monitor */
  .spotlight-visual {
    position: relative;
    height: 320px;
  }

  .terminal {
    height: 100%;
    background: #0f172a;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.15);
    border: 1px solid #1e293b;
    display: flex;
    flex-direction: column;
  }

  .terminal-bar {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 16px;
    background: #1e293b;
    border-bottom: 1px solid #334155;
  }

  .terminal-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .terminal-dot.red {
    background: #ef4444;
  }

  .terminal-dot.yellow {
    background: #eab308;
  }

  .terminal-dot.green {
    background: #22c55e;
  }

  .terminal-title {
    flex: 1;
    text-align: center;
    font-family: "JetBrains Mono", "Fira Code", "Consolas", monospace;
    font-size: 0.7rem;
    color: #64748b;
    letter-spacing: 0.02em;
  }

  .terminal-body {
    flex: 1;
    padding: 16px 20px;
    font-family: "JetBrains Mono", "Fira Code", "Consolas", monospace;
    font-size: 0.78rem;
    display: flex;
    flex-direction: column;
    gap: 8px;
    overflow: hidden;
  }

  .terminal-line {
    display: flex;
    align-items: center;
    gap: 8px;
    opacity: 0;
    animation: fadeInUpTerminal 0.4s ease forwards;
    animation-delay: var(--stagger, 0s);
  }

  @keyframes fadeInUpTerminal {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .terminal-line.prompt {
    margin-bottom: 4px;
  }

  .prompt-sign {
    color: var(--arbol-claro, #3ab34a);
    font-weight: 700;
  }

  .prompt-cmd {
    color: #e2e8f0;
  }

  .cursor {
    color: var(--arbol-claro, #3ab34a);
    animation: blink 1s step-end infinite;
    margin-left: 2px;
  }

  @keyframes blink {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0;
    }
  }

  .terminal-line.log {
    padding-left: 4px;
  }

  .log-check {
    color: var(--arbol-claro, #3ab34a);
    font-weight: 700;
  }

  .log-text {
    color: #cbd5e1;
    flex: 1;
  }

  .log-status {
    color: #94a3b8;
    font-size: 0.72rem;
  }

  .terminal-line.status-line {
    margin-top: auto;
    padding-top: 8px;
    border-top: 1px dashed #334155;
    gap: 10px;
  }

  .terminal-line.uptime-line {
    gap: 10px;
  }

  .status-fill {
    height: 3px;
    border-radius: 2px;
    background: var(--arbol-claro, #3ab34a);
    animation: growBar 1.2s ease backwards;
    animation-delay: var(--stagger, 0s);
  }

  .status-fill.full {
    width: 48px;
    flex-shrink: 0;
  }

  .status-fill.partial {
    width: 34px;
    flex-shrink: 0;
  }

  @keyframes growBar {
    from {
      width: 0;
    }
  }

  .status-label {
    color: #64748b;
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* Secondary Grid */
  .secondary-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 28px;
  }

  .secondary-card {
    position: relative;
    background: #fff;
    border-radius: 24px;
    padding: 36px 32px;
    border: 1px solid #e2e8f0;
    transition:
      transform 0.4s ease,
      box-shadow 0.4s ease;
    animation: fadeInUp 0.6s ease backwards;
    animation-delay: var(--delay);
    overflow: hidden;
  }

  .secondary-card:first-child {
    padding-top: 44px;
  }

  .secondary-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 20px 40px -12px rgba(0, 0, 0, 0.12);
  }

  .sc-accent-bar {
    position: absolute;
    top: 0;
    left: 24px;
    right: 24px;
    height: 3px;
    border-radius: 0 0 3px 3px;
  }

  .secondary-card.green .sc-accent-bar {
    background: linear-gradient(
      90deg,
      var(--arbol-claro, #059669),
      var(--arbol-03, #34d399)
    );
  }

  .secondary-card.emerald .sc-accent-bar {
    background: linear-gradient(90deg, var(--arbol-03, #34d399), #6ee7b7);
  }

  .sc-content {
    position: relative;
    z-index: 2;
  }

  .sc-icon-wrapper {
    position: relative;
    width: 56px;
    height: 56px;
    margin-bottom: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(
      135deg,
      var(--arbol-10, rgba(5, 150, 105, 0.1)),
      rgba(16, 185, 129, 0.1)
    );
    border-radius: 16px;
    transition: transform 0.3s ease;
  }

  .secondary-card:hover .sc-icon-wrapper {
    transform: rotate(-6deg) scale(1.05);
    background: linear-gradient(
      135deg,
      rgba(5, 150, 105, 0.18),
      rgba(16, 185, 129, 0.18)
    );
  }

  .sc-icon {
    font-size: 1.5rem;
    color: var(--arbol-claro, #059669);
  }

  .sc-title {
    font-size: 1.35rem;
    font-weight: 700;
    color: #0f172a;
    margin-bottom: 10px;
    letter-spacing: -0.01em;
  }

  .sc-description {
    color: #64748b;
    font-size: 0.9rem;
    line-height: 1.7;
    margin-bottom: 20px;
  }

  .sc-features {
    list-style: none;
    margin-bottom: 24px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .sc-feature-item {
    display: flex;
    align-items: center;
    gap: 10px;
    color: #475569;
    font-size: 0.85rem;
    transition: all 0.3s ease;
  }

  .secondary-card:hover .sc-feature-item {
    transform: translateX(4px);
  }

  .sc-check {
    width: 16px;
    height: 16px;
    color: var(--arbol-claro, #10b981);
    flex-shrink: 0;
  }

  .sc-cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 12px 20px;
    background: linear-gradient(135deg, #f0fdf4, #ecfdf5);
    border-radius: 10px;
    color: var(--arbol-claro, #059669);
    font-weight: 600;
    font-size: 0.85rem;
    transition: all 0.3s ease;
    border: 1px solid rgba(5, 150, 105, 0.15);
  }

  .sc-cta:hover {
    background: var(--arbol-obscuro, #047857);
    color: #fff;
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(5, 150, 105, 0.25);
    border-color: transparent;
  }

  .sc-cta .cta-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    background: var(--arbol-10, rgba(5, 150, 105, 0.1));
    border-radius: 5px;
    transition: transform 0.3s ease;
  }

  .sc-cta:hover .cta-icon {
    background: rgba(255, 255, 255, 0.2);
    transform: translate(3px) rotate(45deg);
  }

  @media (max-width: 992px) {
    .spotlight-content {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .spotlight-visual {
      height: 280px;
    }
  }

  @media (max-width: 768px) {
    .services {
      padding: 80px 16px;
    }

    .spotlight {
      padding: 28px;
    }

    .spotlight-title {
      font-size: 1.5rem;
    }

    .spotlight-visual {
      height: 240px;
    }

    .terminal-body {
      font-size: 0.7rem;
    }

    .secondary-card {
      padding: 28px 24px;
    }

    .secondary-grid {
      grid-template-columns: 1fr;
    }
  }

  .social-cta-hint {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--arbol-claro, #059669);
    opacity: 0.8;
  }

  .hint-arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    background: var(--arbol-10, rgba(5, 150, 105, 0.1));
    border-radius: 50%;
    font-size: 0.85rem;
    animation: hintBounce 1.5s ease-in-out infinite;
  }

  @keyframes hintBounce {
    0%,
    100% {
      transform: translate(0);
    }
    50% {
      transform: translate(6px);
    }
  }
</style>

<script>
  // Card animation observer
  const cardObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("animate");
        }
      });
    },
    { threshold: 0.2 },
  );

  document
    .querySelectorAll("[data-tilt]")
    .forEach((el) => cardObserver.observe(el));

  // Section header animation
  const headerObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("animate");
        }
      });
    },
    { threshold: 0.3 },
  );

  document
    .querySelectorAll(".section-header")
    .forEach((el) => headerObserver.observe(el));

  // Contadores staggered: arrancan cuando su línea de log aparece
  function startCounters() {
    document.querySelectorAll("[data-counter]").forEach((el, i) => {
      const target = parseInt(el.dataset.counter, 10);
      const duration = 2800;

      setTimeout(() => {
        el.textContent = "0%";
        const start = performance.now();
        function tick(now) {
          const elapsed = now - start;
          const progress = Math.min(elapsed / duration, 1);
          const eased = progress === 1 ? 1 : 1 - Math.pow(2, -10 * progress);
          el.textContent = Math.round(eased * target) + "%";
          if (progress < 1) requestAnimationFrame(tick);
        }
        requestAnimationFrame(tick);
      }, i * 400);
    });
  }

  // Arrancar contadores cuando el terminal entra en viewport
  const terminalObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          startCounters();
          terminalObserver.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.5 },
  );

  const terminal = document.querySelector(".terminal");
  if (terminal) terminalObserver.observe(terminal);

  // Reiniciar animaciones del terminal y contadores cada 9s
  setInterval(() => {
    document.querySelectorAll(".terminal-line").forEach((el) => {
      el.style.animation = "none";
      el.offsetHeight;
      el.style.animation = "";
    });
    startCounters();
  }, 6000);
</script>
