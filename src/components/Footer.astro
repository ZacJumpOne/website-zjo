---
import { PhoneOutlined, MobileOutlined, MailOutlined } from "@ant-design/icons";
---

<footer class="footer" id="footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <div class="footer-brand-content">
          <div class="logo-icon">
            <div class="award-circle">
              <img src="/images/award_cmmi.png" alt="CMMI Certification" />
            </div>
          </div>
          <div class="brand-info">
            <a href="#inicio" class="footer-logo">
              <span class="footer-logo-name font-brand">Zero Jump One</span>
              <span class="footer-logo-tagline"
                >El software que lo hace posible</span
              >
            </a>
            <p class="footer-description">
              Desarrollamos soluciones de software robustas y eficientes para el
              control de tu negocio.
            </p>
          </div>
        </div>
      </div>

      <div class="footer-section">
        <h4 class="footer-heading">Empresa</h4>
        <ul class="footer-list">
          <li><a href="/nuestra-historia">Nuestra Historia</a></li>
          <li><a href="/construyendo">Blog</a></li>
          <li>
            <a href="/aviso-de-privacidad">Aviso de Privacidad Integral</a>
          </li>
        </ul>
      </div>

      <div class="footer-section">
        <h4 class="footer-heading">Ayuda</h4>
        <ul class="footer-list">
          <li><a href="/construyendo">Preguntas Frecuentes</a></li>
          <li><a href="/construyendo">Foro</a></li>
          <li><a href="/ejemplo-procesos">Ejemplo Procesos</a></li>
        </ul>
      </div>

      <div class="footer-section">
        <h4 class="footer-heading">Contacto</h4>
        <ul class="footer-list footer-contact">
          <li>
            <PhoneOutlined />
            <span>(33) 1749-0079</span>
          </li>
          <li>
            <PhoneOutlined />
            <span>(33) 4559-2299</span>
          </li>
          <li>
            <MailOutlined />
            <span>proyectos@zerojumpone.com</span>
          </li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <p>© 2026 Crafted by Zero Jump One. Todos los derechos reservados.</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--bg-dark);
    padding: 60px 20px 30px;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.5fr repeat(3, 1fr);
    gap: 48px;
    margin-bottom: 40px;
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .footer-brand-content {
    display: flex;
    gap: 12px;
    align-items: flex-start;
  }

  .logo-icon {
    flex-shrink: 0;
  }

  .award-circle {
    width: 56px;
    height: 56px;
    background: white;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 6px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
  }

  .award-circle img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .brand-info {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .footer-logo {
    display: block;
    text-decoration: none;
  }

  .footer-logo-name {
    display: block;
    font-weight: 700;
    font-size: 1.125rem;
    color: white;
    line-height: 1.2;
  }

  .footer-logo-tagline {
    display: block;
    font-size: 0.7rem;
    color: var(--primary-light);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 8px;
  }

  .footer-description {
    color: #94a3b8;
    font-size: 0.9rem;
    line-height: 1.6;
  }

  .footer-section {
    display: flex;
    flex-direction: column;
  }

  .footer-heading {
    font-size: 0.875rem;
    font-weight: 600;
    color: white;
    margin-bottom: 16px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .footer-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .footer-list a {
    color: #94a3b8;
    font-size: 0.9rem;
    transition: color 0.2s ease;
  }

  .footer-list a:hover {
    color: var(--primary-light);
  }

  .footer-contact li {
    display: flex;
    align-items: center;
    gap: 10px;
    color: #94a3b8;
    font-size: 0.875rem;
  }

  .footer-contact li :global(.anticon) {
    color: var(--primary-light);
    font-size: 0.9rem;
  }

  .footer-bottom {
    padding-top: 24px;
    border-top: 1px solid #1e293b;
    text-align: center;
    color: #64748b;
    font-size: 0.8rem;
  }

  @media (max-width: 992px) {
    .footer-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 32px;
    }

    .footer-brand {
      grid-column: span 2;
    }
  }

  @media (max-width: 576px) {
    .footer {
      padding: 40px 16px 24px;
    }

    .footer-grid {
      grid-template-columns: 1fr;
      gap: 32px;
      text-align: center;
    }

    .footer-brand {
      grid-column: span 1;
      align-items: center;
    }

    .footer-brand-content {
      flex-direction: column;
      align-items: center;
      gap: 16px;
    }

    .brand-info {
      align-items: center;
    }

    .award-circle {
      width: 48px;
      height: 48px;
      padding: 4px;
    }

    .footer-description {
      max-width: 100%;
      text-align: center;
    }

    .footer-contact li {
      justify-content: center;
    }
  }
</style>
