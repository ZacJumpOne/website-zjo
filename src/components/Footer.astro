---
import {
  PhoneOutlined,
  MailOutlined,
  MessageOutlined,
} from "@ant-design/icons";
import { generales } from "../data/generales";

const year = generales.version.split(".")[0];
---

<footer class="footer" id="footer">
  <div class="container">
    <div class="footer-cta">
      <div class="cta-content">
        <span class="cta-label">Primer paso</span>
        <h3 class="cta-heading">Hablemos de <br /> tu próximo proyecto</h3>
      </div>
      <a href="#contacto" class="footer-cta-link">
        Hablemos <MessageOutlined />
      </a>
    </div>

    <div class="footer-grid">
      <div class="footer-brand">
        <div class="footer-brand-content">
          <div class="logo-icon">
            <div class="award-circle">
              <img
                src="/images/award_cmmi.webp"
                alt="CMMI Certification"
                loading="lazy"
              />
            </div>
          </div>
          <div class="brand-info">
            <a href="#inicio" class="footer-logo">
              <span class="footer-logo-name font-brand">Zero Jump One</span>
              <span class="footer-logo-tagline"
                >El software que lo hace posible</span
              >
            </a>
            <p class="footer-description">
              Desarrollamos soluciones de software robustas y eficientes para el
              control de tu negocio.
            </p>
          </div>
        </div>
      </div>

      <div class="footer-section">
        <h4 class="footer-heading">Empresa</h4>
        <ul class="footer-list">
          <li><a href="/nuestra-historia">Nuestra Historia</a></li>
          <li><a href="/blog">Blog</a></li>
          <li>
            <a href="/aviso-de-privacidad">Aviso de Privacidad Integral</a>
          </li>
        </ul>
      </div>

      <div class="footer-section">
        <h4 class="footer-heading">Ayuda</h4>
        <ul class="footer-list">
          <li><a href="/faqs">Preguntas Frecuentes</a></li>
          <!-- <li><a href="/construyendo">Foro</a></li> -->
          <li><a href="/ejemplo-procesos">Ejemplo de Procesos</a></li>
        </ul>
      </div>

      <div class="footer-section">
        <h4 class="footer-heading">Contacto</h4>
        <ul class="footer-list footer-contact">
          <li>
            <PhoneOutlined />
            <a href="tel:+523317490079" class="footer-contact-link"
              >(33) 1749-0079</a
            >
          </li>
          <li>
            <PhoneOutlined />
            <a href="tel:+5233345592299" class="footer-contact-link"
              >(33) 4559-2299</a
            >
          </li>
          <li>
            <MailOutlined />
            <a
              href="mailto:proyectos@zerojumpone.com"
              class="footer-contact-link">proyectos@zerojumpone.com</a
            >
          </li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <p>© {year} Crafted by Zero Jump One. Todos los derechos reservados.</p>
      <p class="version">v{generales.version}</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--bg-dark);
    padding: 60px 20px 30px;
  }

  .footer-cta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0 0 32px;
    margin-bottom: 32px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    position: relative;
  }

  .cta-content {
    flex: 1;
  }

  .cta-label {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    margin-bottom: 8px;
    color: var(--primary-light);
    background: rgba(16, 185, 129, 0.12);
    padding: 4px 10px;
    border-radius: 4px;
  }

  .cta-heading {
    font-size: 2.45rem;
    font-weight: 700;
    color: white;
    line-height: 1.3;
    margin: 0;
  }

  .footer-cta-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 28px;
    background: transparent;
    border: 2px solid var(--primary-light);
    border-radius: 8px;
    color: white;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
  }

  .footer-cta-link::before {
    content: "";
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(255, 255, 255, 0.3),
      transparent
    );
    transition: left 0.5s ease;
  }

  .footer-cta-link:hover {
    background: var(--primary-light);
    color: var(--bg-dark);
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(16, 185, 129, 0.3);
  }

  .footer-cta-link:hover::before {
    left: 100%;
  }

  .cta-link-text {
    position: relative;
    z-index: 1;
  }

  .cta-cta-arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    position: relative;
    transition: transform 0.3s ease;
  }

  .cta-cta-arrow::after {
    content: "→";
    font-size: 1.2rem;
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    transition: transform 0.3s ease;
  }

  .footer-cta-link:hover .cta-cta-arrow::after {
    transform: translate(-50%, -50%) translateX(4px);
  }

  .cta-line {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(to right, transparent, #1e293b, transparent);
  }

  @media (max-width: 768px) {
    .footer-cta {
      flex-direction: column;
      text-align: center;
      gap: 24px;
    }

    .cta-heading {
      font-size: 1.5rem;
    }
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.5fr repeat(3, 1fr);
    gap: 48px;
    margin-bottom: 40px;
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .footer-brand-content {
    display: flex;
    gap: 12px;
    align-items: flex-start;
  }

  .logo-icon {
    flex-shrink: 0;
  }

  .award-circle {
    width: 56px;
    height: 56px;
    background: white;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 6px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
  }

  .award-circle img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .brand-info {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .footer-logo {
    display: block;
    text-decoration: none;
  }

  .footer-logo-name {
    display: block;
    font-weight: 700;
    font-size: 1.125rem;
    color: white;
    line-height: 1.2;
  }

  .footer-logo-tagline {
    display: block;
    font-size: 0.7rem;
    color: var(--primary-light);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 8px;
  }

  .footer-description {
    color: #94a3b8;
    font-size: 0.9rem;
    line-height: 1.6;
  }

  .footer-section {
    display: flex;
    flex-direction: column;
  }

  .footer-heading {
    font-size: 0.875rem;
    font-weight: 600;
    color: white;
    margin-bottom: 16px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .footer-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .footer-list a {
    color: #94a3b8;
    font-size: 0.9rem;
    transition: color 0.2s ease;
  }

  .footer-list a:hover {
    color: var(--primary-light);
  }

  .footer-contact li {
    display: flex;
    align-items: center;
    gap: 10px;
    color: #94a3b8;
    font-size: 0.875rem;
  }

  .footer-contact li :global(.anticon) {
    color: var(--primary-light);
    font-size: 0.9rem;
  }

  .footer-contact-link {
    color: #94a3b8;
    font-weight: 700;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .footer-contact-link:hover {
    color: var(--primary-light);
  }

  .footer-bottom {
    padding-top: 24px;
    border-top: 1px solid #1e293b;
    text-align: center;
    color: #64748b;
    font-size: 0.8rem;
  }

  .footer-bottom .version {
    margin-top: 8px;
    font-size: 0.7rem;
    color: #475569;
  }

  @media (max-width: 992px) {
    .footer-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 32px;
    }

    .footer-brand {
      grid-column: span 2;
    }
  }

  @media (max-width: 576px) {
    .footer {
      padding: 40px 16px 24px;
    }

    .footer-grid {
      grid-template-columns: 1fr;
      gap: 32px;
      text-align: center;
    }

    .footer-brand {
      grid-column: span 1;
      align-items: center;
    }

    .footer-brand-content {
      flex-direction: column;
      align-items: center;
      gap: 16px;
    }

    .brand-info {
      align-items: center;
    }

    .award-circle {
      width: 48px;
      height: 48px;
      padding: 4px;
    }

    .footer-description {
      max-width: 100%;
      text-align: center;
    }

    .footer-contact li {
      justify-content: center;
    }
  }
</style>
